<Window x:Class="NetX.App.Dialogs.CommandOutputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinXTools"
        Height="560" Width="840"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title (drag to move) -->
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Style="{StaticResource SubHeaderTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       Background="Transparent"
                       MouseLeftButtonDown="Title_MouseLeftButtonDown"/>

            <!-- Status: running bar + text -->
            <StackPanel Grid.Row="1" Margin="0,12,0,12">
                <Border x:Name="BusyTrack"
                        Height="4"
                        CornerRadius="2"
                        Background="{StaticResource BgTertiaryBrush}"
                        ClipToBounds="True">
                    <Border x:Name="BusyIndicator"
                            Width="160"
                            HorizontalAlignment="Left"
                            CornerRadius="2"
                            Background="{StaticResource AccentPrimaryBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BusyShift" X="-160"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock x:Name="StatusText"
                           Margin="0,10,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Output -->
            <TextBox x:Name="OutputBox"
                     Grid.Row="2"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="12"
                     Padding="10,8"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button x:Name="CopyButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Click="CopyButton_Click"/>
                <Button x:Name="CancelButton"
                        Style="{StaticResource DangerButtonStyle}"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="CloseButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="20,8"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
