<Page x:Class="NetX.App.Views.CleanerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="System Cleaner"
      Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Cleaner_Title}"
                           Style="{StaticResource HeaderTextStyle}"
                           FontSize="28"/>
                <TextBlock Text="{DynamicResource Cleaner_Subtitle}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ScanButton"
                        Content="{DynamicResource Cleaner_Scan}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Scan_Click"
                        Margin="0,0,12,0"/>
                <Button x:Name="CancelButton"
                        Content="{DynamicResource Cleaner_Cancel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click"
                        Visibility="Collapsed"
                        Margin="0,0,12,0"/>
                <Button x:Name="CleanButton"
                        Content="{DynamicResource Cleaner_Clean}"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="Clean_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Categories + summary -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" x:Name="CategoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanToggle}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource SubHeaderTextStyle}"
                                                   FontSize="15"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding DetailVisibility}"/>
                                        <TextBlock Text="{Binding Note}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding NoteVisibility}"/>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{Binding RiskBrush}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            Margin="12,0,16,0">
                                        <TextBlock Text="{Binding RiskText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding RiskForeground}"/>
                                    </Border>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding SizeText}"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               MinWidth="96"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Summary Panel -->
                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cleaner_Summary}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="{DynamicResource Cleaner_Selected}"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="TotalSizeText"
                                   Text="--"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="FilesCountText"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="SkippedText"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                        <ProgressBar x:Name="CleanProgress"
                                     Height="8"
                                     Foreground="{StaticResource AccentPrimaryBrush}"
                                     Background="{StaticResource BgTertiaryBrush}"
                                     Visibility="Collapsed"
                                     Margin="0,24,0,8"/>
                        <TextBlock x:Name="StatusText"
                                   Text="{DynamicResource Cleaner_Hint}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Footer Info -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,8" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                      Fill="{StaticResource InfoBrush}"
                      Width="16" Height="16"
                      Stretch="Uniform"
                      Margin="0,0,8,0"/>
                <TextBlock Text="{DynamicResource Cleaner_Footer}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
