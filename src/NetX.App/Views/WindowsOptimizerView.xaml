        <Geometry x:Key="GamingIcon">M7.97,16L5,19C4.67,19.3 4.23,19.5 3.75,19.5A1.75,1.75 0 0,1 2,17.75V17.5L3,10.12C3.21,7.81 5.14,6 7.5,6H16.5C18.86,6 20.79,7.81 21,10.12L22,17.5V17.75A1.75,1.75 0 0,1 20.25,19.5C19.77,19.5 19.33,19.3 19,19L16.03,16H7.97M7,8V10H5V11H7V13H8V11H10V10H8V8H7M16.5,8A0.75,0.75 0 0,0 15.75,8.75A0.75,0.75 0 0,0 16.5,9.5A0.75,0.75 0 0,0 17.25,8.75A0.75,0.75 0 0,0 16.5,8M14.75,9.75A0.75,0.75 0 0,0 14,10.5A0.75,0.75 0 0,0 14.75,11.25A0.75,0.75 0 0,0 15.5,10.5A0.75,0.75 0 0,0 14.75,9.75M18.25,9.75A0.75,0.75 0 0,0 17.5,10.5A0.75,0.75 0 0,0 18.25,11.25A0.75,0.75 0 0,0 19,10.5A0.75,0.75 0 0,0 18.25,9.75M16.5,11.5A0.75,0.75 0 0,0 15.75,12.25A0.75,0.75 0 0,0 16.5,13A0.75,0.75 0 0,0 17.25,12.25A0.75,0.75 0 0,0 16.5,11.5Z</Geometry>
        <Geometry x:Key="CheckIcon">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</Geometry>
        <Geometry x:Key="WarningIcon">M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</Geometry>
        <Geometry x:Key="InfoIcon">M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</Geometry>
        <Geometry x:Key="ApplyIcon">M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z</Geometry>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="{DynamicResource WinOptimizer_Title}"
                           Style="{StaticResource HeaderTextStyle}"
                           FontSize="28"/>
                <TextBlock Text="{DynamicResource WinOptimizer_Subtitle}"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Create Restore Point Button -->
            <Button x:Name="CreateRestoreBtn"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="16,10"
                    Click="CreateRestoreBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource RestoreIcon}"
                          Fill="{StaticResource AccentPrimaryBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource WinOptimizer_CreateRestore}"
                               FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Optimization Categories -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Category Tabs -->
                <Border Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabServices" Content="{DynamicResource WinOptimizer_Services}"
                                     GroupName="Category" IsChecked="True"
                                     Style="{StaticResource CategoryTabStyle}"
                                     Click="CategoryTab_Click" Tag="Services"/>
                        <RadioButton x:Name="TabAI" Content="{DynamicResource WinOptimizer_AIFeatures}"
                                     GroupName="Category"
                                     Style="{StaticResource CategoryTabStyle}"
                                     Click="CategoryTab_Click" Tag="AI" Margin="8,0,0,0"/>
                        <RadioButton x:Name="TabTelemetry" Content="{DynamicResource WinOptimizer_Telemetry}"
                                     GroupName="Category"
                                     Style="{StaticResource CategoryTabStyle}"
                                     Click="CategoryTab_Click" Tag="Telemetry" Margin="8,0,0,0"/>
                        <RadioButton x:Name="TabStartup" Content="{DynamicResource WinOptimizer_Startup}"
                                     GroupName="Category"
                                     Style="{StaticResource CategoryTabStyle}"
                                     Click="CategoryTab_Click" Tag="Startup" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Items List -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- List Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="SelectAllCheckBox"
                                          VerticalAlignment="Center"
                                          Click="SelectAll_Click"/>
                                <TextBlock Text="{DynamicResource WinOptimizer_SelectAll}"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RefreshBtn"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        Click="RefreshBtn_Click">
                                    <TextBlock Text="{DynamicResource Common_Refresh}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Items ListView -->
                        <ListView Grid.Row="1"
                                  x:Name="ItemsList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgTertiaryBrush}"
                                            CornerRadius="8"
                                            Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Click="ItemCheckBox_Click"/>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"/>
                                                    <!-- Risk Badge -->
                                                    <Border Margin="8,0,0,0"
                                                            Padding="6,2"
                                                            CornerRadius="4"
                                                            Background="{Binding RiskBadgeBackground}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RiskText}"
                                                                   FontSize="10"
                                                                   Foreground="{Binding RiskBadgeForeground}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="400"
                                                           Margin="0,4,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{Binding StatusColor}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RamSavingText}"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               FontSize="11"
                                                               Margin="12,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Category Icon -->
                                            <Path Grid.Column="2"
                                                  Data="{Binding CategoryIcon}"
                                                  Fill="{StaticResource TextTertiaryBrush}"
                                                  Width="20" Height="20"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0"/>

                                            <!-- Toggle Button -->
                                            <Button Grid.Column="3"
                                                    Style="{Binding ToggleButtonStyle}"
                                                    Padding="12,6"
                                                    Click="ToggleItem_Click"
                                                    Tag="{Binding}"
                                                    MinWidth="80">
                                                <TextBlock Text="{Binding ToggleButtonText}"
                                                           FontSize="11"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Panel: Summary and Actions -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Summary Card -->
                <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource WinOptimizer_Summary}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,16"/>

                        <!-- Stats Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource WinOptimizer_Selected}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="11"/>
                                <TextBlock x:Name="SelectedCountText" Text="0"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource AccentPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource WinOptimizer_Disabled}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="11"/>
                                <TextBlock x:Name="DisabledCountText" Text="0"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1">
                                <TextBlock Text="{DynamicResource WinOptimizer_EstimatedRAM}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="11"/>
                                <TextBlock x:Name="EstimatedRamText" Text="0 MB"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="1">
                                <TextBlock Text="{DynamicResource WinOptimizer_TotalItems}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="11"/>
                                <TextBlock x:Name="TotalItemsText" Text="0"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource WinOptimizer_QuickActions}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,16"/>

                        <!-- Apply Selected Button -->
                        <Button x:Name="ApplySelectedBtn"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="0,12"
                                Click="ApplySelectedBtn_Click"
                                Margin="0,0,0,8"
                                HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ApplyIcon}"
                                      Fill="White"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource WinOptimizer_ApplySelected}"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Safe Optimize Button -->
                        <Button x:Name="SafeOptimizeBtn"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="0,10"
                                Click="SafeOptimizeBtn_Click"
                                Margin="0,0,0,8"
                                HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ShieldIcon}"
                                      Fill="{StaticResource SuccessBrush}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource WinOptimizer_SafeOptimize}"
                                           FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Restore All Button -->
                        <Button x:Name="RestoreAllBtn"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="0,10"
                                Click="RestoreAllBtn_Click"
                                HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource RestoreIcon}"
                                      Fill="{StaticResource WarningBrush}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource WinOptimizer_RestoreAll}"
                                           FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Warning Card -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16"
                        Background="#15f59e0b" BorderBrush="#40f59e0b">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="{StaticResource WarningIcon}"
                              Fill="{StaticResource WarningBrush}"
                              Width="24" Height="24"
                              Stretch="Uniform"
                              VerticalAlignment="Top"
                              Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource WinOptimizer_WarningTitle}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <TextBlock Text="{DynamicResource WinOptimizer_WarningText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Restore Points List -->
                <Border Grid.Row="3" Style="{StaticResource GlassCardStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource WinOptimizer_RestorePoints}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,12"/>

                        <ListView Grid.Row="1"
                                  x:Name="RestorePointsList"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgTertiaryBrush}"
                                            CornerRadius="6" Padding="12,10">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CreationTimeText}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="10"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <TextBlock x:Name="NoRestorePointsText"
                                   Grid.Row="1"
                                   Text="{DynamicResource WinOptimizer_NoRestorePoints}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
