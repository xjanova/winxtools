<Page x:Class="NetX.App.Views.NetworkMonitorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Network Monitor"
      Background="{StaticResource BgPrimaryBrush}">

    <Page.Resources>
        <Geometry x:Key="SortUpIcon">M7,15L12,10L17,15H7Z</Geometry>
        <Geometry x:Key="SortDownIcon">M7,10L12,15L17,10H7Z</Geometry>
        <Geometry x:Key="KillIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="BlockIcon">M12,2C17.5,2 22,6.5 22,12C22,17.5 17.5,22 12,22C6.5,22 2,17.5 2,12C2,6.5 6.5,2 12,2M12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4M16.24,7.76L7.76,16.24L16.24,7.76Z</Geometry>
        <Geometry x:Key="AutoKillIcon">M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M15.5,7.5L17,9L13.5,12.5L17,16L15.5,17.5L12,14L8.5,17.5L7,16L10.5,12.5L7,9L8.5,7.5L12,11L15.5,7.5Z</Geometry>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource Network_Title}"
                       Style="{StaticResource HeaderTextStyle}"
                       FontSize="28"/>
        </StackPanel>

        <!-- Search and Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgTertiaryBrush}"
                        CornerRadius="8"
                        Padding="12,8"
                        MaxWidth="400"
                        HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="{StaticResource TextTertiaryBrush}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Filter Buttons and Kill Auto Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                    <RadioButton x:Name="ShowAllBtn"
                                 Content="{DynamicResource Network_ShowAll}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 IsChecked="True"
                                 Checked="Filter_Changed"
                                 Margin="0,0,12,0"/>
                    <RadioButton x:Name="ActiveOnlyBtn"
                                 Content="{DynamicResource Network_ActiveOnly}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Checked="Filter_Changed"/>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="16,4"/>

                    <!-- Kill Auto Toggle -->
                    <CheckBox x:Name="AutoKillToggle"
                              Click="AutoKillToggle_Click"
                              Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource AutoKillIcon}"
                                  Fill="{StaticResource DangerBrush}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Kill Auto" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </CheckBox>

                    <!-- Smart Kill Toggle -->
                    <CheckBox x:Name="SmartKillToggle"
                              Click="SmartKillToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Smart Kill" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <!-- Chart Type -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <RadioButton x:Name="LineChartBtn"
                                 Content="{DynamicResource Network_ChartLine}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 IsChecked="True"
                                 Checked="ChartType_Changed"
                                 Margin="0,0,12,0"/>
                    <RadioButton x:Name="BarChartBtn"
                                 Content="{DynamicResource Network_ChartBar}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Checked="ChartType_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Process List -->
            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sortable Column Headers -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <!-- PID Header -->
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                Click="SortColumn_Click" Tag="ProcessId"
                                HorizontalContentAlignment="Left" Padding="4,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PID" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Path x:Name="SortPID" Width="10" Height="10" Stretch="Uniform" Margin="4,0,0,0"
                                      Fill="{StaticResource TextTertiaryBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Process Name Header -->
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                Click="SortColumn_Click" Tag="ProcessName"
                                HorizontalContentAlignment="Left" Padding="4,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Network_ProcessName}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Path x:Name="SortName" Width="10" Height="10" Stretch="Uniform" Margin="4,0,0,0"
                                      Fill="{StaticResource TextTertiaryBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Download Header -->
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                Click="SortColumn_Click" Tag="DownloadSpeed"
                                HorizontalContentAlignment="Right" Padding="4,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↓ Download" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}"/>
                                <Path x:Name="SortDownload" Width="10" Height="10" Stretch="Uniform" Margin="4,0,0,0"
                                      Fill="{StaticResource AccentPrimaryBrush}" Data="{StaticResource SortDownIcon}"/>
                            </StackPanel>
                        </Button>

                        <!-- Upload Header -->
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}"
                                Click="SortColumn_Click" Tag="UploadSpeed"
                                HorizontalContentAlignment="Right" Padding="4,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↑ Upload" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                <Path x:Name="SortUpload" Width="10" Height="10" Stretch="Uniform" Margin="4,0,0,0"
                                      Fill="{StaticResource TextTertiaryBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Mini Chart Header -->
                        <TextBlock Grid.Column="4" Text="Activity" Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Connections Header -->
                        <Button Grid.Column="5" Style="{StaticResource SecondaryButtonStyle}"
                                Click="SortColumn_Click" Tag="ConnectionCount"
                                HorizontalContentAlignment="Center" Padding="4,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Conn" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Path x:Name="SortConn" Width="10" Height="10" Stretch="Uniform" Margin="4,0,0,0"
                                      Fill="{StaticResource TextTertiaryBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Actions Header -->
                        <TextBlock Grid.Column="6" Text="Actions" Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Process ListView -->
                    <ListView Grid.Row="1"
                              x:Name="ProcessList"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionChanged="ProcessList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="8"
                                                    Margin="0,2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1affffff"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2600d4ff"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ProcessId}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ProcessName}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DownloadSpeedText}"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding UploadSpeedText}"
                                               Foreground="{StaticResource SuccessBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                    <!-- Mini Bandwidth Bar Chart -->
                                    <Grid Grid.Column="4" Height="20" Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource AccentPrimaryBrush}" Opacity="0.3"
                                                CornerRadius="2" VerticalAlignment="Bottom"
                                                Height="{Binding DownloadBarHeight}"/>
                                        <Border Grid.Column="1" Background="{StaticResource SuccessBrush}" Opacity="0.3"
                                                CornerRadius="2" VerticalAlignment="Bottom"
                                                Height="{Binding UploadBarHeight}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="5"
                                               Text="{Binding ConnectionCount}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Kill Process Button -->
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="5,4"
                                                Click="KillProcess_Click"
                                                Tag="{Binding ProcessId}"
                                                ToolTip="Kill Process"
                                                Margin="0,0,2,0">
                                            <Path Data="{StaticResource KillIcon}"
                                                  Fill="{StaticResource DangerBrush}"
                                                  Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                        <!-- Auto-Kill Toggle Button -->
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="5,4"
                                                Click="AutoKillProcess_Click"
                                                Tag="{Binding ProcessName}"
                                                ToolTip="Auto-Kill (prevent from reopening)"
                                                Margin="0,0,2,0">
                                            <Path Data="{StaticResource AutoKillIcon}"
                                                  Fill="{StaticResource WarningBrush}"
                                                  Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                        <!-- Block Network Button -->
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="5,4"
                                                Click="BlockProcess_Click"
                                                Tag="{Binding ProcessId}"
                                                ToolTip="Block Network">
                                            <Path Data="{StaticResource BlockIcon}"
                                                  Fill="{StaticResource TextTertiaryBrush}"
                                                  Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Process Info -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="SelectedProcessName"
                                   Text="Select a process"
                                   Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBlock x:Name="SelectedProcessDetails"
                                   Text="Click on a process to view details"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Speed Chart -->
                    <lvc:CartesianChart Grid.Row="1"
                                        x:Name="DetailChart"
                                        Background="Transparent"/>

                    <!-- Bandwidth Control Section -->
                    <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}"
                            CornerRadius="10" Padding="16" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Bandwidth Control"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,12"/>

                            <!-- Current Speed Display -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CurrentDownloadSpeed" Text="0 B/s"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Download" FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CurrentUploadSpeed" Text="0 B/s"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Upload" FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Bandwidth Limit Slider -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Limit:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <Slider x:Name="BandwidthLimitSlider" Grid.Column="1"
                                        Minimum="0" Maximum="100" Value="0"
                                        ValueChanged="BandwidthLimitSlider_ValueChanged"
                                        VerticalAlignment="Center"/>

                                <TextBlock x:Name="BandwidthLimitText" Grid.Column="2"
                                           Text="Unlimited"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Speed Preset Buttons -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Unlimited" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6" Margin="0,0,6,0"
                                        Click="SpeedPreset_Click" Tag="0"/>
                                <Button Content="1 MB/s" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6" Margin="0,0,6,0"
                                        Click="SpeedPreset_Click" Tag="25"/>
                                <Button Content="512 KB/s" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6" Margin="0,0,6,0"
                                        Click="SpeedPreset_Click" Tag="50"/>
                                <Button Content="Block" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        Click="SpeedPreset_Click" Tag="100"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Connection Details -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Active Connections"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>

                        <ListView Grid.Row="1"
                                  x:Name="ConnectionsList"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgTertiaryBrush}"
                                            CornerRadius="6" Padding="10,8" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding RemoteAddress}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="10"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="6,4" Click="BlockConnection_Click"
                                                    Tag="{Binding RemoteAddress}" ToolTip="Block IP">
                                                <Path Data="M12,2C17.5,2 22,6.5 22,12C22,17.5 17.5,22 12,22C6.5,22 2,17.5 2,12C2,6.5 6.5,2 12,2M12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4M16.24,7.76L7.76,16.24L16.24,7.76Z"
                                                      Fill="{StaticResource DangerBrush}"
                                                      Width="10" Height="10" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="12,8" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText"
                           Text="Monitoring network activity..."
                           Style="{StaticResource BodyTextStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
