<Page x:Class="NetX.App.Views.RulesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource Rules_Title}">

    <Page.Resources>
        <Geometry x:Key="AddIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
        <Geometry x:Key="EditIcon">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</Geometry>
        <Geometry x:Key="DeleteIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="RuleIcon">M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7Z</Geometry>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="160"/>
            <RowDefinition Height="*" MinHeight="140"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Rules_Title}"
                           Style="{StaticResource HeaderTextStyle}"
                           FontSize="28"/>
                <TextBlock x:Name="RulesCountText"
                           Text="{DynamicResource Rules_Subtitle}"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,4,0,0"/>
                <!-- Engine status: running / paused (no Pro) / storage problem -->
                <DockPanel Margin="0,8,20,0">
                    <Ellipse x:Name="StatusDot"
                             DockPanel.Dock="Left"
                             Width="8" Height="8"
                             Fill="{StaticResource TextTertiaryBrush}"
                             VerticalAlignment="Top"
                             Margin="0,5,8,0"/>
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </StackPanel>

            <Button x:Name="NewRuleButton"
                    Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Top"
                    Click="AddRule_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource AddIcon}"
                          Fill="White"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Rules_NewRule}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Rules List -->
        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="0">
            <Grid>
                <ListView x:Name="RulesList"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="20,16"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Border"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#10ffffff"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status Icon -->
                                <Border Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="{Binding StatusBackground}">
                                    <Path Data="{StaticResource RuleIcon}"
                                          Fill="{Binding StatusColor}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <!-- Rule Info -->
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Border Background="{StaticResource AccentTertiaryBrush}"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                Margin="0,0,8,4"
                                                MaxWidth="320">
                                            <TextBlock Text="{Binding ConditionsText}"
                                                       FontSize="10"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Border Background="{StaticResource AuroraPurpleBrush}"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                Margin="0,0,0,4"
                                                MaxWidth="320">
                                            <TextBlock Text="{Binding ActionsText}"
                                                       FontSize="10"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Stats: how often, when and how the rule last ran -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                                    <TextBlock Text="{Binding TriggerCountText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding LastTriggeredText}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               FontSize="10"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding LastResultText}"
                                               Foreground="{Binding LastResultBrush}"
                                               FontSize="10"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Toggle -->
                                <ToggleButton Grid.Column="3"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Click="ToggleRule_Click"
                                              Tag="{Binding Id}"
                                              ToolTip="{DynamicResource Rules_ToggleTooltip}"
                                              VerticalAlignment="Center"
                                              Margin="10,0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="SwitchBorder"
                                                                Width="50" Height="26"
                                                                CornerRadius="13"
                                                                Background="#40ffffff"
                                                                Cursor="Hand">
                                                            <Ellipse x:Name="SwitchCircle"
                                                                     Width="20" Height="20"
                                                                     Fill="White"
                                                                     HorizontalAlignment="Left"
                                                                     Margin="3,0,0,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="SwitchBorder" Property="Background" Value="{StaticResource AuroraGreenBrush}"/>
                                                                <Setter TargetName="SwitchCircle" Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter TargetName="SwitchCircle" Property="Margin" Value="0,0,3,0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <!-- Actions -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,8"
                                            Margin="0,0,8,0"
                                            Click="EditRule_Click"
                                            Tag="{Binding Id}"
                                            ToolTip="{DynamicResource Rules_EditTooltip}">
                                        <Path Data="{StaticResource EditIcon}"
                                              Fill="{StaticResource AccentPrimaryBrush}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,8"
                                            Click="DeleteRule_Click"
                                            Tag="{Binding Id}"
                                            ToolTip="{DynamicResource Rules_DeleteTooltip}">
                                        <Path Data="{StaticResource DeleteIcon}"
                                              Fill="{StaticResource DangerBrush}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Path Data="{StaticResource RuleIcon}"
                          Fill="{StaticResource TextTertiaryBrush}"
                          Width="64" Height="64" Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Opacity="0.5"/>
                    <TextBlock Text="{DynamicResource Rules_EmptyTitle}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="{DynamicResource Rules_EmptyDesc}"
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <Button x:Name="CreateRuleButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddRule_Click"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource AddIcon}"
                                  Fill="White"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Rules_CreateRule}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Activity log: what the rules did in this session -->
        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Margin="0,16,0,0" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{DynamicResource Rules_ActivityTitle}"
                           Style="{StaticResource SubHeaderTextStyle}"
                           FontSize="14"
                           Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ActivityList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6" ToolTip="{Binding Text}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding DotBrush}"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Margin="0,5,0,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Time}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,1,0,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Text}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="ActivityEmptyText"
                           Grid.Row="1"
                           Text="{DynamicResource Rules_ActivityEmpty}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="12"
                           FontStyle="Italic"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Page>
