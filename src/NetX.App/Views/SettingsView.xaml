<Page x:Class="NetX.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="{StaticResource BgPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{DynamicResource Settings_Title}"
                           Style="{StaticResource HeaderTextStyle}"
                           FontSize="28"/>
            </StackPanel>

            <!-- General Settings -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_General}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Language -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_Language}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Select application language"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="LanguageCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  SelectionChanged="Language_Changed">
                            <ComboBoxItem Content="English" Tag="en-US" IsSelected="True"/>
                            <ComboBoxItem Content="ไทย (Thai)" Tag="th-TH"/>
                        </ComboBox>
                    </Grid>

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_StartWithWindows}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Launch WinXTools when Windows starts"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  x:Name="StartWithWindowsToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"/>
                    </Grid>

                    <!-- Minimize to Tray -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_MinimizeToTray}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Keep running in system tray when minimized"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  x:Name="MinimizeToTrayToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="True"/>
                    </Grid>

                    <!-- Notifications -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_Notifications}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Show desktop notifications"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  x:Name="NotificationsToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network Settings -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_Network}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Refresh Rate -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_RefreshRate}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="How often to update network stats"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="RefreshRateCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}">
                            <ComboBoxItem Content="500ms (Fast)" Tag="500"/>
                            <ComboBoxItem Content="1 second" Tag="1000" IsSelected="True"/>
                            <ComboBoxItem Content="2 seconds" Tag="2000"/>
                            <ComboBoxItem Content="5 seconds" Tag="5000"/>
                        </ComboBox>
                    </Grid>

                    <!-- Data Retention -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_DataRetention}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="How long to keep network history"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="DataRetentionCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}">
                            <ComboBoxItem Content="7 days" Tag="7"/>
                            <ComboBoxItem Content="14 days" Tag="14"/>
                            <ComboBoxItem Content="30 days" Tag="30" IsSelected="True"/>
                            <ComboBoxItem Content="90 days" Tag="90"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bandwidth Control Settings -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Nav_BandwidthControl}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Default Mode -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default Control Mode"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Mode to use when adding new rules"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="ControlModeCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}">
                            <ComboBoxItem Content="Basic Mode" Tag="basic" IsSelected="True"/>
                            <ComboBoxItem Content="Advanced Mode (WFP)" Tag="advanced"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RAM Optimizer Settings -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="RAM Optimizer"
                                   Style="{StaticResource SubHeaderTextStyle}"/>
                        <Border Background="{StaticResource SuccessBrush}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="RamStatusText" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <!-- Current RAM Usage -->
                    <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="TotalRamText" Text="-- GB" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Total RAM" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="UsedRamText" Text="-- GB" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Used" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="AvailableRamText" Text="-- GB" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Available" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Auto Optimize Toggle -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto Optimize RAM"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Automatically clean RAM when usage exceeds threshold"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  x:Name="AutoOptimizeRamToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Click="AutoOptimizeRam_Click"/>
                    </Grid>

                    <!-- Optimize Interval -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Optimize Interval"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="How often to check and optimize RAM"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="RamIntervalCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  SelectionChanged="RamInterval_Changed">
                            <ComboBoxItem Content="5 minutes" Tag="5"/>
                            <ComboBoxItem Content="15 minutes" Tag="15"/>
                            <ComboBoxItem Content="30 minutes" Tag="30" IsSelected="True"/>
                            <ComboBoxItem Content="1 hour" Tag="60"/>
                        </ComboBox>
                    </Grid>

                    <!-- Memory Threshold -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Memory Threshold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Optimize when RAM usage exceeds this percentage"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="RamThresholdCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  SelectionChanged="RamThreshold_Changed">
                            <ComboBoxItem Content="60%" Tag="60"/>
                            <ComboBoxItem Content="70%" Tag="70"/>
                            <ComboBoxItem Content="80%" Tag="80" IsSelected="True"/>
                            <ComboBoxItem Content="90%" Tag="90"/>
                        </ComboBox>
                    </Grid>

                    <!-- Manual Optimize Button -->
                    <Button Content="Optimize RAM Now"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OptimizeRamNow_Click"
                            HorizontalAlignment="Left"
                            Padding="20,10"/>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_About}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- App Info -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="64" Height="64"
                                CornerRadius="12"
                                Background="{StaticResource AccentGradientBrush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="WX"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WinXTools"
                                       Style="{StaticResource SubHeaderTextStyle}"
                                       FontSize="20"/>
                            <TextBlock Text="{DynamicResource AppTagline}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{DynamicResource AppVersion}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource AppCredit}"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Settings_CheckUpdates}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CheckUpdates_Click"
                                Margin="0,0,8,0"/>

                        <Button Content="{DynamicResource Settings_ResetSettings}"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ResetSettings_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Admin Status -->
            <Border Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Administrator Status"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="AdminStatusText"
                                   Text="Checking..."
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            x:Name="AdminBadge"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="4"
                            Padding="12,6">
                        <TextBlock x:Name="AdminBadgeText"
                                   Text="Admin"
                                   FontWeight="SemiBold"
                                   FontSize="11"/>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
