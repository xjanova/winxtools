<Page x:Class="NetX.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{DynamicResource Settings_Title}"
                           Style="{StaticResource HeaderTextStyle}"
                           FontSize="28"/>
            </StackPanel>

            <!-- General Settings -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_General}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Language -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_Language}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Select application language"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="LanguageCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  SelectionChanged="Language_Changed">
                            <ComboBoxItem Content="English" Tag="en-US" IsSelected="True"/>
                            <ComboBoxItem Content="ไทย (Thai)" Tag="th-TH"/>
                        </ComboBox>
                    </Grid>

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_StartWithWindows}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Launch WinXTools when Windows starts"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  x:Name="StartWithWindowsToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"/>
                    </Grid>

                    <!-- Minimize to Tray -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_MinimizeToTray}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Keep running in system tray when minimized"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  x:Name="MinimizeToTrayToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="True"/>
                    </Grid>

                    <!-- Notifications -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_Notifications}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Show desktop notifications"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  x:Name="NotificationsToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network Settings -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_Network}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Refresh Rate -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_RefreshRate}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="How often to update network stats"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="RefreshRateCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}">
                            <ComboBoxItem Content="500ms (Fast)" Tag="500"/>
                            <ComboBoxItem Content="1 second" Tag="1000" IsSelected="True"/>
                            <ComboBoxItem Content="2 seconds" Tag="2000"/>
                            <ComboBoxItem Content="5 seconds" Tag="5000"/>
                        </ComboBox>
                    </Grid>

                    <!-- Data Retention -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_DataRetention}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="How long to keep network history"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="DataRetentionCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}">
                            <ComboBoxItem Content="7 days" Tag="7"/>
                            <ComboBoxItem Content="14 days" Tag="14"/>
                            <ComboBoxItem Content="30 days" Tag="30" IsSelected="True"/>
                            <ComboBoxItem Content="90 days" Tag="90"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bandwidth Control Settings -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Nav_BandwidthControl}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Default Mode -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default Control Mode"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Mode to use when adding new rules"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="ControlModeCombo"
                                  Background="{StaticResource BgTertiaryBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}">
                            <ComboBoxItem Content="Basic Mode" Tag="basic" IsSelected="True"/>
                            <ComboBoxItem Content="Advanced Mode (WFP)" Tag="advanced"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RAM Optimizer Quick Access -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Nav_RamOptimizer}"
                                   Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBlock Text="{DynamicResource Settings_RamOptimizerDesc}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{DynamicResource Settings_OpenRamOptimizer}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenRamOptimizer_Click"
                            VerticalAlignment="Center"
                            Padding="16,10"/>
                </Grid>
            </Border>

            <!-- License Key -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_License}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- License Status -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_LicenseStatus}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="LicenseStatusText"
                                       Text="Free"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                x:Name="LicenseBadge"
                                Background="{StaticResource BgTertiaryBrush}"
                                CornerRadius="4"
                                Padding="12,6">
                            <TextBlock x:Name="LicenseBadgeText"
                                       Text="Free"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- License Key Input -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="LicenseKeyInput"
                                 Grid.Column="0"
                                 Background="{StaticResource BgTertiaryBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="1"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Padding="10,8"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="ActivateButton"
                                Content="{DynamicResource Settings_Activate}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ActivateLicense_Click"
                                Margin="8,0,0,0"
                                Padding="16,8"/>
                    </Grid>

                    <!-- Deactivate -->
                    <Button x:Name="DeactivateButton"
                            Content="{DynamicResource Settings_Deactivate}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="DeactivateLicense_Click"
                            Visibility="Collapsed"
                            Padding="16,8"/>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_Updates}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Update Status -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="UpdateStatusText"
                                       Text="{DynamicResource Settings_UpToDate}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="UpdateVersionText"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="UpdateNowButton"
                                    Content="{DynamicResource Settings_UpdateNow}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="UpdateNow_Click"
                                    Visibility="Collapsed"
                                    Padding="16,8"
                                    Margin="0,0,8,0"/>

                            <Button x:Name="CheckUpdateButton"
                                    Content="{DynamicResource Settings_CheckUpdates}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CheckUpdates_Click"
                                    Padding="16,8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Download Progress -->
                    <StackPanel x:Name="DownloadProgressPanel" Visibility="Collapsed">
                        <ProgressBar x:Name="DownloadProgressBar"
                                     Height="6"
                                     Minimum="0" Maximum="100"
                                     Background="{StaticResource BgTertiaryBrush}"
                                     Foreground="{StaticResource AccentPrimaryBrush}"
                                     Margin="0,0,0,4"/>
                        <TextBlock x:Name="DownloadProgressText"
                                   Text="Downloading..."
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_About}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- App Info -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="64" Height="64"
                                CornerRadius="12"
                                Background="{StaticResource AccentGradientBrush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="WX"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WinXTools"
                                       Style="{StaticResource SubHeaderTextStyle}"
                                       FontSize="20"/>
                            <TextBlock Text="{DynamicResource AppTagline}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="VersionText"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource AppCredit}"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <!-- Actions -->
                    <Button Content="{DynamicResource Settings_ResetSettings}"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="ResetSettings_Click"/>
                </StackPanel>
            </Border>

            <!-- Admin Status -->
            <Border Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Administrator Status"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="AdminStatusText"
                                   Text="Checking..."
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            x:Name="AdminBadge"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="4"
                            Padding="12,6">
                        <TextBlock x:Name="AdminBadgeText"
                                   Text="Admin"
                                   FontWeight="SemiBold"
                                   FontSize="11"/>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
