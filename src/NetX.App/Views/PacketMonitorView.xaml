<Page x:Class="NetX.App.Views.PacketMonitorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Packet Monitor">

    <Page.Resources>
        <Geometry x:Key="InboundIcon">M7,10L12,15L17,10H7Z</Geometry>
        <Geometry x:Key="OutboundIcon">M7,14L12,9L17,14H7Z</Geometry>
        <Geometry x:Key="FilterIcon">M14,12V19.88C14.04,20.18 13.94,20.5 13.71,20.71C13.32,21.1 12.69,21.1 12.3,20.71L10.29,18.7C10.06,18.47 9.96,18.16 10,17.87V12H9.97L4.21,4.62C3.87,4.19 3.95,3.56 4.38,3.22C4.57,3.08 4.78,3 5,3H19C19.22,3 19.43,3.08 19.62,3.22C20.05,3.56 20.13,4.19 19.79,4.62L14.03,12H14Z</Geometry>
        <Geometry x:Key="StartIcon">M8,5.14V19.14L19,12.14L8,5.14Z</Geometry>
        <Geometry x:Key="StopIcon">M18,18H6V6H18V18Z</Geometry>
        <Geometry x:Key="ClearIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="ExportIcon">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,19L8,15H10.5V12H13.5V15H16L12,19Z</Geometry>
        <Geometry x:Key="TCPIcon">M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2Z</Geometry>
        <Geometry x:Key="UDPIcon">M12,2L22,12L12,22L2,12L12,2Z</Geometry>
    </Page.Resources>

    <Grid Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Controls -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Capture Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="StartStopBtn" Style="{StaticResource PrimaryButtonStyle}"
                            Click="StartStop_Click" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="StartStopIcon" Data="{StaticResource StartIcon}"
                                  Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StartStopText" Text="Start Capture"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="Clear_Click" Padding="12,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ClearIcon}"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Clear"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="Export_Click" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ExportIcon}"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Statistics -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" Padding="16,8" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Total Packets" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="TotalPacketsText" Text="0" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" Padding="16,8" Margin="0,0,16,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource InboundIcon}" Fill="{StaticResource AccentPrimaryBrush}"
                                      Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Text="Inbound" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="InboundPacketsText" Text="0" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" Padding="16,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource OutboundIcon}" Fill="{StaticResource AccentSecondaryBrush}"
                                      Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Text="Outbound" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="OutboundPacketsText" Text="0" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Capture Rate -->
                <Border Grid.Column="2" Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="Packets/sec" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                        <TextBlock x:Name="PacketRateText" Text="0" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Background="{StaticResource BgTertiaryBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Path Data="{StaticResource FilterIcon}" Fill="{StaticResource TextSecondaryBrush}"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <!-- Protocol Filters -->
                    <CheckBox x:Name="FilterTCP" Content="TCP" IsChecked="True" Margin="0,0,16,0"
                              Foreground="{StaticResource TextSecondaryBrush}" Click="Filter_Changed"/>
                    <CheckBox x:Name="FilterUDP" Content="UDP" IsChecked="True" Margin="0,0,16,0"
                              Foreground="{StaticResource TextSecondaryBrush}" Click="Filter_Changed"/>
                    <CheckBox x:Name="FilterICMP" Content="ICMP" IsChecked="True" Margin="0,0,16,0"
                              Foreground="{StaticResource TextSecondaryBrush}" Click="Filter_Changed"/>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,0,16,0"/>

                    <!-- Direction Filters -->
                    <CheckBox x:Name="FilterInbound" Content="Inbound" IsChecked="True" Margin="0,0,16,0"
                              Foreground="{StaticResource TextSecondaryBrush}" Click="Filter_Changed"/>
                    <CheckBox x:Name="FilterOutbound" Content="Outbound" IsChecked="True" Margin="0,0,16,0"
                              Foreground="{StaticResource TextSecondaryBrush}" Click="Filter_Changed"/>
                </StackPanel>

                <!-- Search/Filter Expression -->
                <TextBox Grid.Column="1" x:Name="FilterExpression"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="" Margin="20,0"
                         TextChanged="FilterExpression_Changed">
                    <TextBox.Tag>Filter: ip.addr == 192.168.1.1 or port == 443</TextBox.Tag>
                </TextBox>

                <!-- Process Filter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Process:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="ProcessFilter" Width="180" SelectionChanged="ProcessFilter_Changed">
                        <ComboBoxItem Content="All Processes" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content - Split View -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Packet List -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}" Margin="20,16,0,16" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column Headers -->
                    <Border Grid.Row="0" Background="{StaticResource BgTertiaryBrush}" CornerRadius="10,10,0,0" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Time" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="Dir" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="Proto" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="Source" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="5" Text="Port" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="6" Text="Destination" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="7" Text="Port" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="8" Text="Size" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Packet ListView -->
                    <ListView Grid.Row="1" x:Name="PacketList"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionChanged="PacketList_SelectionChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Number}"
                                               Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeStr}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    <Path Grid.Column="2"
                                          Data="{Binding DirectionIcon}"
                                          Fill="{Binding DirectionColor}"
                                          Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Protocol}"
                                               Foreground="{Binding ProtocolColor}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Column="4" Text="{Binding SourceIP}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="5" Text="{Binding SourcePort}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Grid.Column="6" Text="{Binding DestIP}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="7" Text="{Binding DestPort}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Grid.Column="8" Text="{Binding SizeStr}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgTertiaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#10ffffff"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Packet Details Panel -->
            <Border Grid.Column="2" Background="{StaticResource BgSecondaryBrush}" Margin="0,16,20,16" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Detail Header -->
                    <Border Grid.Row="0" Background="{StaticResource BgTertiaryBrush}" CornerRadius="10,10,0,0" Padding="16,12">
                        <TextBlock Text="Packet Details" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- Detail Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PacketDetailsPanel" Margin="16">
                            <TextBlock x:Name="NoPacketSelected" Text="Select a packet to view details"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontStyle="Italic"/>

                            <!-- General Info -->
                            <StackPanel x:Name="DetailSection" Visibility="Collapsed">
                                <TextBlock Text="General" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Time:" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailTime" Foreground="{StaticResource TextSecondaryBrush}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Protocol:" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailProtocol" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Direction:" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailDirection" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Size:" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailSize" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Process:" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailProcess" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </Grid>

                                <!-- Source/Destination -->
                                <TextBlock Text="Endpoints" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Source" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="DetailSource" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Destination" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="DetailDest" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Flags/Info -->
                                <TextBlock Text="TCP Flags" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,8"
                                           x:Name="FlagsHeader"/>
                                <WrapPanel x:Name="FlagsPanel" Margin="0,0,0,16">
                                    <!-- Flags will be added dynamically -->
                                </WrapPanel>

                                <!-- Hex View -->
                                <TextBlock Text="Payload (Hex)" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" Padding="12">
                                    <TextBlock x:Name="HexView" FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxHeight="200"/>
                                </Border>

                                <!-- Actions -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8"
                                            Margin="0,0,8,0" Click="BlockIP_Click">
                                        <TextBlock Text="Block Source IP"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8"
                                            Click="CopyPacket_Click">
                                        <TextBlock Text="Copy Details"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgSecondaryBrush}" Padding="20,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="CaptureIndicator" Width="8" Height="8" Fill="{StaticResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready to capture"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="BufferStatus" Text="Buffer: 0 / 10,000 packets"
                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Page>
