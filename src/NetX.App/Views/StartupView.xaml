<Page x:Class="NetX.App.Views.StartupView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Startup"
      Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Startup_Title}" Style="{StaticResource HeaderTextStyle}" FontSize="28"/>
                <TextBlock Text="{DynamicResource Startup_Subtitle}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="{DynamicResource Startup_Refresh}"
                    Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="Refresh_Click"/>
        </Grid>

        <!-- Something to look at now (a remote-control program under another name, an unsigned program in a temp folder) -->
        <Border Grid.Row="1" x:Name="AlertBanner" Visibility="Collapsed" Margin="0,0,0,12" Padding="14,10" CornerRadius="10"
                Background="#33FF4D4D" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{DynamicResource Startup_AlertTitle}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource DangerBrush}"/>
                <TextBlock x:Name="AlertText" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- The three things to do -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Startup_GameTitle}" Style="{StaticResource SubHeaderTextStyle}" FontSize="15"/>
                    <TextBlock x:Name="GameText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                    <CheckBox x:Name="LightestOption" Margin="0,8,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                        <TextBlock Text="{DynamicResource Startup_Lightest}" TextWrapping="Wrap" FontSize="12"/>
                    </CheckBox>
                    <Button x:Name="GameButton" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Game_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Startup_RecommendedTitle}" Style="{StaticResource SubHeaderTextStyle}" FontSize="15"/>
                    <TextBlock x:Name="RecommendedText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                    <Button x:Name="RecommendedButton" Content="{DynamicResource Startup_RecommendedButton}" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="Recommended_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource GlassCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Startup_SummaryTitle}" Style="{StaticResource SubHeaderTextStyle}" FontSize="15"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                    <Button x:Name="UndoAllButton" Content="{DynamicResource Startup_UndoAll}" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="UndoAll_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter + status -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FilterBox" Width="260" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="{DynamicResource Startup_FilterAll}" IsSelected="True"/>
                <ComboBoxItem Content="{DynamicResource Startup_FilterTurnOff}"/>
                <ComboBoxItem Content="{DynamicResource Startup_FilterChoice}"/>
                <ComboBoxItem Content="{DynamicResource Startup_FilterKeep}"/>
                <ComboBoxItem Content="{DynamicResource Startup_FilterOff}"/>
            </ComboBox>
            <TextBlock Grid.Column="1" x:Name="StatusText" Style="{StaticResource BodyTextStyle}" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>

        <!-- Everything that starts with Windows -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanSwitch}"
                                          Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Margin="0,0,14,0"
                                          Click="Toggle_Click" ToolTip="{Binding LockTip}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GroupText}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Border Background="#3300C8FF" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Visibility="{Binding GameTagVisibility}">
                                            <TextBlock Text="{Binding GameText}" FontSize="10.5" Foreground="{StaticResource AccentPrimaryBrush}"/>
                                        </Border>
                                        <Border Background="#33FFB020" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                Visibility="{Binding ChangeVisibility}">
                                            <TextBlock Text="{Binding ChangeText}" FontSize="10.5" Foreground="{StaticResource WarningBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding What}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Why}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{Binding WhyBrush}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="{Binding VerdictBrush}" CornerRadius="4" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VerdictText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding VerdictForeground}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
