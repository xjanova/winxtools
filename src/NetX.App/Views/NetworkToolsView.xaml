    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource NetworkTools_Title}"
                       Style="{StaticResource HeaderTextStyle}"
                       FontSize="28"/>
            <TextBlock Text="{DynamicResource NetworkTools_Subtitle}"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tool Selection Panel -->
            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Diagnostics" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   Margin="12,4,0,4"/>
                        <RadioButton x:Name="ToolPing" Content="Ping" GroupName="Tools"
                                     IsChecked="True" Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolTraceroute" Content="Traceroute" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolDns" Content="DNS Lookup" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolPortScan" Content="Port Scanner" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolWhois" Content="Whois" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>

                        <TextBlock Text="Security" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   Margin="12,12,0,4"/>
                        <RadioButton x:Name="ToolSslCheck" Content="SSL Checker" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolHttpHeaders" Content="HTTP Headers" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>

                        <TextBlock Text="Network Info" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Margin="12,12,0,4"/>
                        <RadioButton x:Name="ToolIpInfo" Content="My IP" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolSubnet" Content="Subnet Calculator" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolIpConverter" Content="IP Converter" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolArp" Content="ARP Table" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolRoute" Content="Route Table" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolNetStats" Content="Network Stats" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>

                        <TextBlock Text="Packet Tools" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AuroraPinkBrush}"
                                   Margin="12,12,0,4"/>
                        <RadioButton x:Name="ToolPacketSender" Content="Packet Sender" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>

                        <TextBlock Text="Utilities" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AuroraCyanBrush}"
                                   Margin="12,12,0,4"/>
                        <RadioButton x:Name="ToolWol" Content="Wake-on-LAN" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                        <RadioButton x:Name="ToolSpeedTest" Content="Speed Test" GroupName="Tools"
                                     Checked="Tool_Changed"
                                     Style="{StaticResource ToolRadioStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Tool Content Panel -->
            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tool Title -->
                    <TextBlock x:Name="ToolTitle" Grid.Row="0"
                               Text="Ping"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Input Area -->
                    <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid x:Name="InputPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InputHost" Grid.Column="0"
                                     Background="{StaticResource BgTertiaryBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0"
                                     Padding="12,8"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Text="google.com"
                                     KeyDown="Input_KeyDown"/>

                            <!-- Run/Cancel live outside InputHost so tools that need no
                                 input (My IP, ARP Table, ...) still have a Run button. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ExecuteBtn"
                                        Content="{DynamicResource Common_Execute}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="24,8"
                                        Margin="12,0,0,0"
                                        Click="ExecuteBtn_Click"/>
                                <Button x:Name="CancelBtn"
                                        Content="{DynamicResource Common_Cancel}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="18,8"
                                        Margin="8,0,0,0"
                                        Visibility="Collapsed"
                                        Click="CancelBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Output Area -->
                    <Border Grid.Row="2" Background="{StaticResource BgTertiaryBrush}"
                            CornerRadius="8" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="OutputText"
                                       Text="Enter a host and click Execute to run the tool."
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
