<Page x:Class="NetX.App.Views.UninstallerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Uninstaller"
      Background="Transparent">

    <Page.Resources>
        <!-- Modal "please wait" card while an uninstaller runs or leftovers are searched/moved.
             Hosted in a borderless window from code-behind; DataContext = BusyDialogModel. -->
        <DataTemplate x:Key="UninstallBusyTemplate">
            <Border Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Margin="16"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Message}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                 Maximum="100"
                                 Margin="0,16,0,0"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="{Binding CancelText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,8"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            IsCancel="True"
                            IsEnabled="{Binding CanCancel}"
                            Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="BusyCancel_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Leftover picker: every folder found, with real sizes. Nothing is pre-selected;
             DataContext = LeftoverPickerModel. -->
        <DataTemplate x:Key="UninstallLeftoverTemplate">
            <Border Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Margin="16"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding Title}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Message}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,16"/>

                    <CheckBox Grid.Row="2"
                              IsChecked="{Binding AllSelected, Mode=TwoWay}"
                              VerticalContentAlignment="Center"
                              Margin="12,0,0,8">
                        <TextBlock Text="{DynamicResource Uninstall_SelectAll}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="4,0,0,0"/>
                    </CheckBox>

                    <ScrollViewer Grid.Row="3"
                                  MaxHeight="340"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgTertiaryBrush}"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,0,0,6">
                                        <!-- Whole row toggles the checkbox -->
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Center">
                                            <Grid Margin="8,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Path}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding KindText}"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Margin="16,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding FilesText}"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="4"
                               Text="{Binding SelectionSummary}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="{DynamicResource Uninstall_KeepAll}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8"
                                IsCancel="True"
                                Click="LeftoverKeep_Click"/>
                        <Button Content="{DynamicResource Uninstall_MoveToRecycleBin}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,8"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding HasSelection}"
                                Click="LeftoverRemove_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Windows app removal: exactly what goes, a warning per app where it matters, and the
             optional "keep it from coming back" tick (never pre-ticked);
             DataContext = StoreRemoveConfirmModel. -->
        <DataTemplate x:Key="UninstallStoreConfirmTemplate">
            <Border Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Margin="16"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding Title}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Message}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,16"/>

                    <ScrollViewer Grid.Row="2"
                                  MaxHeight="320"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgTertiaryBrush}"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Note}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Warning}"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <CheckBox Grid.Row="3"
                              IsChecked="{Binding KeepAway, Mode=TwoWay}"
                              ToolTip="{Binding KeepAwayValues}"
                              VerticalContentAlignment="Top"
                              Margin="0,12,0,0"
                              Visibility="{Binding KeepAwayAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{DynamicResource Uninstall_KeepAwayOption}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding KeepAwayDetails}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <!-- Enter and Esc both keep everything: removing needs a click on the red button -->
                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="{DynamicResource Common_Cancel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8"
                                IsCancel="True"
                                IsDefault="True"
                                Click="StoreConfirmCancel_Click"/>
                        <Button Content="{Binding RemoveText}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,8"
                                Margin="8,0,0,0"
                                Click="StoreConfirmRemove_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource Uninstall_Title}"
                       Style="{StaticResource HeaderTextStyle}"
                       FontSize="28"/>
            <TextBlock x:Name="CountText"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgTertiaryBrush}"
                        CornerRadius="8"
                        Padding="12,8"
                        MinWidth="280"
                        MaxWidth="400"
                        HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3Z"
                              Fill="{StaticResource TextTertiaryBrush}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="SearchPlaceholder"
                                   Text="{DynamicResource Uninstall_Search}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="13"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Show System Apps Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="{DynamicResource Uninstall_ShowSystem}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <CheckBox x:Name="ShowSystemApps"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="ShowSystemApps_Changed"
                              Unchecked="ShowSystemApps_Changed"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Content="{DynamicResource Uninstall_Refresh}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Refresh_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="ScanButton"
                            Content="{DynamicResource Uninstall_Scan}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Scan_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Windows apps (Microsoft Store): what to show, the quiet status note, and removing several at once -->
        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Uninstall_FilterLabel}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="SourceFilter"
                              Width="210"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectedIndex="0"
                              SelectionChanged="SourceFilter_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Uninstall_FilterAll}"/>
                        <ComboBoxItem Content="{DynamicResource Uninstall_FilterDesktop}"/>
                        <ComboBoxItem Content="{DynamicResource Uninstall_FilterStore}"/>
                        <ComboBoxItem Content="{DynamicResource Uninstall_FilterPreinstalled}"/>
                        <ComboBoxItem Content="{DynamicResource Uninstall_FilterSafe}"/>
                    </ComboBox>
                </StackPanel>

                <!-- "Reading…", how many were found, or why Windows apps could not be read -->
                <TextBlock Grid.Column="1"
                           x:Name="StoreNoteText"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="16,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Only while WinXTools has "keep it from coming back" settings to put back -->
                    <Button x:Name="UndoKeepAwayButton"
                            Content="{DynamicResource Uninstall_KeepAwayUndo}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="UndoKeepAway_Click"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"/>
                    <Button x:Name="SelectSafeButton"
                            Content="{DynamicResource Uninstall_SelectSafe}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SelectSafe_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="RemoveSelectedButton"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="RemoveSelected_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Programs List -->
        <Border Grid.Row="3" Style="{StaticResource GlassCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Uninstall_ColProgram}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Uninstall_Size}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{DynamicResource Uninstall_InstallDate}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{DynamicResource Uninstall_Actions}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Programs ListView -->
                <ListView Grid.Row="1"
                          x:Name="ProgramsList"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,12"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="8"
                                                Margin="0,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1affffff"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2600d4ff"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                    <!-- Wide enough for the Thai button labels -->
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon (desktop program) -->
                                <Border Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="6"
                                        Background="{StaticResource BgTertiaryBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStoreApp}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Data="M6,2A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z"
                                          Fill="{StaticResource AccentPrimaryBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"/>
                                </Border>

                                <!-- Tick box (Windows app): several can be removed with one confirmation -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsStoreApp, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Name & Publisher · version · scope -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Name}"
                                               ToolTip="{Binding Name}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Details}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Windows app: what kind it is, the verdict, and one sentence about it -->
                                    <DockPanel Margin="0,4,0,0"
                                               Visibility="{Binding IsStoreApp, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border DockPanel.Dock="Left"
                                                Background="{StaticResource BgTertiaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Badge}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border DockPanel.Dock="Left"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,0"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VerdictKind}" Value="SafeToRemove">
                                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding VerdictText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VerdictKind}" Value="SafeToRemove">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Description}"
                                                   ToolTip="{Binding Hint}"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Size -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Size}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           HorizontalAlignment="Right"/>

                                <!-- Install Date -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding InstallDate}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>

                                <!-- Actions (desktop program) -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStoreApp}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="{DynamicResource Uninstall_Uninstall}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,6"
                                            Click="Uninstall_Click"
                                            Margin="0,0,4,0"/>
                                    <Button Content="{DynamicResource Uninstall_DeepClean}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="10,6"
                                            Click="DeepClean_Click"/>
                                </StackPanel>

                                <!-- Action (Windows app): Windows removes the package and its data itself -->
                                <Button Grid.Column="4"
                                        Content="{DynamicResource Uninstall_StoreRemove}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="10,6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Click="StoreRemove_Click"
                                        Visibility="{Binding IsStoreApp, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Loading / empty / no-match / error state -->
                <TextBlock Grid.Row="1"
                           x:Name="ListStateText"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,24"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
