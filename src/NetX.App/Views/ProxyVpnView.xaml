<Page x:Class="NetX.App.Views.ProxyVpnView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Free Proxy"
      Background="Transparent">

    <Page.Resources>
        <!-- Country Card Style -->
        <Style x:Key="CountryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#25304860" Offset="0"/>
                                <GradientStop Color="#1500a8e8" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icons -->
        <Geometry x:Key="GlobeIcon">M17.9,17.39C17.64,16.59 16.89,16 16,16H15V13A1,1 0 0,0 14,12H8V10H10A1,1 0 0,0 11,9V7H13A2,2 0 0,0 15,5V4.59C17.93,5.77 20,8.64 20,12C20,14.08 19.2,15.97 17.9,17.39M11,19.93C7.05,19.44 4,16.08 4,12C4,11.38 4.08,10.79 4.21,10.21L9,15V16A2,2 0 0,0 11,18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</Geometry>
        <Geometry x:Key="ConnectIcon">M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z</Geometry>
        <Geometry x:Key="DisconnectIcon">M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z</Geometry>
        <Geometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="WarningIcon">M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z</Geometry>
        <Geometry x:Key="SpeedIcon">M12,16A3,3 0 0,1 9,13C9,11.88 9.61,10.9 10.5,10.39L20.21,4.77L14.68,14.35C14.18,15.33 13.17,16 12,16M12,3C13.81,3 15.5,3.5 16.97,4.32L14.87,5.53C14,5.19 13,5 12,5A8,8 0 0,0 4,13C4,15.21 4.89,17.21 6.34,18.65H6.35C6.74,19.04 6.74,19.67 6.35,20.06C5.96,20.45 5.32,20.45 4.93,20.07V20.07C3.12,18.26 2,15.76 2,13A10,10 0 0,1 12,3M22,13C22,15.76 20.88,18.26 19.07,20.07V20.07C18.68,20.45 18.05,20.45 17.66,20.06C17.27,19.67 17.27,19.04 17.66,18.65V18.65C19.11,17.2 20,15.21 20,13C20,12 19.81,11 19.46,10.1L20.67,8C21.5,9.5 22,11.18 22,13Z</Geometry>
        <Geometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Connection Status -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- Globe, not a shield: this is a plain proxy, it adds no protection -->
                        <Path Data="{StaticResource GlobeIcon}" Fill="{StaticResource AccentPrimaryBrush}"
                              Width="28" Height="28" Stretch="Uniform" Margin="0,0,12,0"/>
                        <TextBlock Text="{DynamicResource ProxyVpn_Title}" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource ProxyVpn_Subtitle}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="40,4,0,0"/>
                </StackPanel>

                <!-- Connection Status Card -->
                <Border Grid.Column="1" x:Name="StatusCard" CornerRadius="16" Padding="20,12" Margin="16,0,0,0"
                        Background="{StaticResource BgTertiaryBrush}" MinWidth="300" MaxWidth="480">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status Indicator -->
                        <Ellipse x:Name="StatusIndicator" Width="16" Height="16" Fill="#ef4444" Margin="0,0,12,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#ef4444" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="{DynamicResource Proxy_StatusNotConnected}"
                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="StatusDetail" Text="{DynamicResource Proxy_StatusPickCountry}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Button x:Name="DisconnectBtn" Grid.Column="2" Style="{StaticResource DangerButtonStyle}"
                                Visibility="Collapsed" Click="DisconnectBtn_Click" Padding="12,8" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource DisconnectIcon}" Fill="White" Width="14" Height="14"
                                      Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Proxy_Disconnect}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Honesty notice: a plain system proxy, not a VPN -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" Padding="24,0,24,16">
            <Border Background="#1Af59e0b" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource WarningIcon}" Fill="{StaticResource WarningBrush}"
                          Width="18" Height="18" Stretch="Uniform" Margin="0,1,10,0" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Proxy_Warning}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
            </Border>
        </Border>

        <!-- Search and Filter Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgTertiaryBrush}" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource SearchIcon}" Fill="{StaticResource TextTertiaryBrush}"
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                 VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                    <TextBlock Text="{DynamicResource Proxy_SearchPlaceholder}" IsHitTestVisible="False"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               VerticalAlignment="Center" Margin="2,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Region Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <RadioButton x:Name="AllRegionBtn" Content="All" IsChecked="True" GroupName="Region"
                                 Style="{StaticResource FilterRadioStyle}" Tag="All" Checked="RegionFilter_Changed"/>
                    <RadioButton Content="Asia" GroupName="Region" Style="{StaticResource FilterRadioStyle}"
                                 Tag="Asia" Checked="RegionFilter_Changed"/>
                    <RadioButton Content="Europe" GroupName="Region" Style="{StaticResource FilterRadioStyle}"
                                 Tag="Europe" Checked="RegionFilter_Changed"/>
                    <RadioButton Content="America" GroupName="Region" Style="{StaticResource FilterRadioStyle}"
                                 Tag="America" Checked="RegionFilter_Changed"/>
                    <RadioButton Content="Other" GroupName="Region" Style="{StaticResource FilterRadioStyle}"
                                 Tag="Other" Checked="RegionFilter_Changed"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshBtn_Click"
                        Padding="12,8" ToolTip="{DynamicResource Proxy_RefreshTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource RefreshIcon}" Fill="{StaticResource TextPrimaryBrush}"
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Common_Refresh}" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Countries Grid -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="16">
            <ItemsControl x:Name="CountriesGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Clicking the card only (re)loads the list; the Connect button connects -->
                        <Border Style="{StaticResource CountryCardStyle}" Width="200" MouseLeftButtonUp="Country_Click"
                                Tag="{Binding Code}" ToolTip="{DynamicResource Proxy_CardTooltip}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Flag and Country Name -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Flag}" FontSize="32" VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Region}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Listed (untested) proxy count -->
                                <Border Grid.Row="1" Background="{StaticResource BgTertiaryBrush}"
                                        CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ProxyCountText}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>

                                <!-- Quick Connect Button -->
                                <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                        Click="QuickConnect_Click" Tag="{Binding Code}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource ConnectIcon}" Fill="White"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Proxy_Connect}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading Overlay (connect / refresh) - always cancellable -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="4" Background="#80000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentPrimaryBrush}"/>
                <TextBlock x:Name="LoadingText" Text="{DynamicResource Common_Loading}" FontSize="14" Margin="0,12,0,0"
                           Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420"/>
                <Button x:Name="CancelOperationBtn" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,8"
                        Click="CancelOperationBtn_Click">
                    <TextBlock Text="{DynamicResource Common_Cancel}" FontSize="12"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
