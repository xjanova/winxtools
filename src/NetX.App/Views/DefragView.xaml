<Page x:Class="NetX.App.Views.DefragView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:NetX.App.Controls"
      Title="Defragment"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HudValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StatName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="LegendText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="5,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Defrag_Title}" Style="{StaticResource HeaderTextStyle}" FontSize="28"/>
                <TextBlock Text="{DynamicResource Defrag_Subtitle}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AnalyzeButton" Content="{DynamicResource Defrag_Analyze}" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Analyze_Click" Margin="0,0,10,0"/>
                <Button x:Name="OptimizeButton" Content="{DynamicResource Defrag_Optimize}" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Optimize_Click" Margin="0,0,10,0"/>
                <Button x:Name="StopButton" Content="{DynamicResource Defrag_Stop}" Style="{StaticResource DangerButtonStyle}"
                        Click="Stop_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Drives -->
        <ItemsControl Grid.Row="1" x:Name="DriveList" Margin="0,0,0,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="DefragDrive" Style="{StaticResource DriveCardStyle}"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 IsEnabled="{Binding IsEnabled}"
                                 Checked="DriveCard_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LetterText}" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Model}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiaryBrush}" ToolTip="{Binding Model}"/>
                                <Border Background="{Binding BadgeBrush}" CornerRadius="4" Padding="6,1" Margin="0,5,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding MediaText}" FontSize="10" FontWeight="SemiBold" Foreground="Black"/>
                                </Border>
                                <Grid Height="5" Margin="0,7,0,3">
                                    <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="2.5"/>
                                    <Border Background="{StaticResource AccentGradientHorizontalBrush}" CornerRadius="2.5"
                                            HorizontalAlignment="Left" Width="{Binding UsedBarWidth}"/>
                                </Grid>
                                <TextBlock Text="{Binding UsageText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding FragText}" FontSize="11" Foreground="{Binding FragBrush}"
                                           Visibility="{Binding FragVisibility}"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 3D view + side panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.4" RadiusX="0.8" RadiusY="0.9">
                        <GradientStop Color="#13284a" Offset="0"/>
                        <GradientStop Color="#081125" Offset="0.6"/>
                        <GradientStop Color="#040814" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
                <Grid>
                    <controls:DiskScene3D x:Name="Scene"/>

                    <!-- HUD: drive and progress -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,14,0,0" IsHitTestVisible="False">
                        <TextBlock x:Name="HudDrive" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="HudMedia" FontSize="11" Foreground="{StaticResource AccentLightBrush}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="HudPercent" FontFamily="{StaticResource MonoFont}" FontSize="44" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,6,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00c8ff" BlurRadius="22" ShadowDepth="0" Opacity="0.75"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="HudPhase" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="360"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- HUD: live numbers -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0" Padding="12,8" CornerRadius="10"
                            Background="#990a1428" BorderBrush="#331e90ff" BorderThickness="1" IsHitTestVisible="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource Defrag_HudRead}" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="HudRead" Text="—" Style="{StaticResource HudValue}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Defrag_HudWrite}" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="HudWrite" Text="—" Style="{StaticResource HudValue}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Defrag_HudMoved}" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="HudMoved" Text="—" Style="{StaticResource HudValue}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="3" Text="{DynamicResource Defrag_HudElapsed}" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="HudElapsed" Text="—" Style="{StaticResource HudValue}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="CenterMessage" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,46"
                               TextAlignment="Center" TextWrapping="Wrap" FontSize="13" MaxWidth="520" IsHitTestVisible="False"
                               Foreground="{StaticResource TextPrimaryBrush}" Visibility="Collapsed">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="{DynamicResource Defrag_ViewHint}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,16,12" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False"/>

                    <!-- While data moves on a USB drive: don't unplug it -->
                    <Border x:Name="UnplugBanner" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,14"
                            Padding="12,6" CornerRadius="8" Background="#E6301A05" BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="{DynamicResource Defrag_UnplugBanner}" Foreground="{StaticResource WarningBrush}"
                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"/>
                    </Border>
                    <ProgressBar x:Name="RunProgress" VerticalAlignment="Bottom" Height="4" Margin="0" BorderThickness="0"
                                 Background="#22000000" Foreground="{StaticResource AccentPrimaryBrush}" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Side panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Defrag_StatusTitle}" Style="{StaticResource SubHeaderTextStyle}" FontSize="15"/>
                            <TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"/>
                            <TextBlock x:Name="AdviceText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Defrag_BeforeAfter}" Style="{StaticResource SubHeaderTextStyle}" FontSize="15"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Defrag_Before}" Style="{StaticResource StatName}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Defrag_After}" Style="{StaticResource StatName}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Text="{DynamicResource Defrag_StatFragmentation}" Style="{StaticResource StatName}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BeforeFrag" Text="—" Style="{StaticResource StatNumber}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AfterFrag" Text="—" Style="{StaticResource StatNumber}"/>

                                <TextBlock Grid.Row="2" Text="{DynamicResource Defrag_StatFiles}" Style="{StaticResource StatName}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BeforeFiles" Text="—" Style="{StaticResource StatNumber}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="AfterFiles" Text="—" Style="{StaticResource StatNumber}"/>

                                <TextBlock Grid.Row="3" Text="{DynamicResource Defrag_StatPieces}" Style="{StaticResource StatName}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BeforePieces" Text="—" Style="{StaticResource StatNumber}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="AfterPieces" Text="—" Style="{StaticResource StatNumber}"/>

                                <TextBlock Grid.Row="4" Text="{DynamicResource Defrag_StatFreeFrag}" Style="{StaticResource StatName}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BeforeFree" Text="—" Style="{StaticResource StatNumber}"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="AfterFree" Text="—" Style="{StaticResource StatNumber}"/>

                                <TextBlock Grid.Row="5" Text="{DynamicResource Defrag_StatLargestFree}" Style="{StaticResource StatName}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="BeforeLargest" Text="—" Style="{StaticResource StatNumber}"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" x:Name="AfterLargest" Text="—" Style="{StaticResource StatNumber}"/>

                                <TextBlock Grid.Row="6" Text="{DynamicResource Defrag_StatReadSpeed}" Style="{StaticResource StatName}"
                                           ToolTip="{DynamicResource Defrag_StatReadSpeedTip}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="BeforeSpeed" Text="—" Style="{StaticResource StatNumber}"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="AfterSpeed" Text="—" Style="{StaticResource StatNumber}"/>
                            </Grid>
                            <TextBlock x:Name="GainText" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Defrag_Options}" Style="{StaticResource SubHeaderTextStyle}" FontSize="15"/>
                            <CheckBox x:Name="MeasureOption" IsChecked="True" Margin="0,8,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                                <TextBlock Text="{DynamicResource Defrag_OptMeasure}" TextWrapping="Wrap" FontSize="12"/>
                            </CheckBox>
                            <CheckBox x:Name="ConsolidateOption" Margin="0,8,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                                <TextBlock Text="{DynamicResource Defrag_OptConsolidate}" TextWrapping="Wrap" FontSize="12"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Smart placement: programs' start-up files together, from Windows' own Prefetch records -->
                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,12" x:Name="SmartCard" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Defrag_SmartTitle}" Style="{StaticResource SubHeaderTextStyle}" FontSize="15"/>
                            <TextBlock x:Name="SmartSummary" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                            <ItemsControl x:Name="SmartPrograms" Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11" Margin="8,0,0,0"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="SmartButton" Content="{DynamicResource Defrag_SmartArrange}" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="SmartArrange_Click"/>
                            <CheckBox x:Name="SmartAutoOption" Margin="0,10,0,0" Foreground="{StaticResource TextPrimaryBrush}" Click="SmartAuto_Click">
                                <TextBlock Text="{DynamicResource Defrag_SmartAuto}" TextWrapping="Wrap" FontSize="12"/>
                            </CheckBox>
                            <TextBlock x:Name="SmartLastAuto" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" x:Name="WorstCard" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Defrag_WorstFiles}" Style="{StaticResource SubHeaderTextStyle}" FontSize="15"/>
                            <ItemsControl x:Name="WorstList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PiecesText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource WarningBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Flat map + legend -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,10" CornerRadius="10" Background="{StaticResource BgSecondaryBrush}">
            <StackPanel>
                <controls:ClusterMapView x:Name="FlatMap" Height="92"/>
                <WrapPanel Margin="0,8,0,0">
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#35A6FF"/>
                    <TextBlock Text="{DynamicResource Defrag_LegendUsed}" Style="{StaticResource LegendText}"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#FF6A3D"/>
                    <TextBlock Text="{DynamicResource Defrag_LegendFragmented}" Style="{StaticResource LegendText}"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#0E1A31" Stroke="#2d4a6f"/>
                    <TextBlock Text="{DynamicResource Defrag_LegendFree}" Style="{StaticResource LegendText}"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#B46CFF"/>
                    <TextBlock Text="{DynamicResource Defrag_LegendSystem}" Style="{StaticResource LegendText}"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#E2E8F0"/>
                    <TextBlock Text="{DynamicResource Defrag_LegendUnmovable}" Style="{StaticResource LegendText}"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#FFF1B8"/>
                    <TextBlock Text="{DynamicResource Defrag_LegendMoved}" Style="{StaticResource LegendText}"/>
                    <TextBlock x:Name="MapCaption" Style="{StaticResource LegendText}" Foreground="{StaticResource TextTertiaryBrush}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
