<Page x:Class="NetX.App.Views.BandwidthControlView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Bandwidth Control"
      Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Nav_BandwidthControl}"
                                   Style="{StaticResource HeaderTextStyle}"
                                   FontSize="28"/>
                        <TextBlock Text="{DynamicResource BW_PageSubtitle}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Real limiter status (never claims "active" unless packets are diverted) -->
                    <Border Grid.Column="1"
                            x:Name="EngineStatusBadge"
                            Background="{StaticResource BgTertiaryBrush}"
                            CornerRadius="16"
                            Padding="12,6"
                            MaxWidth="420"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EngineStatusDot"
                                     Width="8" Height="8"
                                     Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="EngineStatusText"
                                       Text="{DynamicResource BW_Status_Idle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Whole-PC limit -->
                <TextBlock Text="{DynamicResource BW_WholePcTitle}"
                           Style="{StaticResource SubHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource BW_WholePcDesc}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,12"/>

                <ItemsControl x:Name="InterfacesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="180"/>
                                    </Grid.RowDefinitions>

                                    <!-- Interface Header with Icon -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border Width="48" Height="48"
                                                    CornerRadius="12"
                                                    Background="{Binding IconBrush}"
                                                    Margin="0,0,16,0">
                                                <Path Data="{Binding IconPath}"
                                                      Fill="White"
                                                      Width="24" Height="24"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="16"/>
                                                <TextBlock Text="{Binding InterfaceType}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Current Speed Display -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource BgTertiaryBrush}"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                                          Fill="{StaticResource AccentPrimaryBrush}"
                                                          Width="14" Height="14"
                                                          Stretch="Uniform"
                                                          Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding CurrentDownloadSpeed}"
                                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgTertiaryBrush}"
                                                    CornerRadius="8"
                                                    Padding="12,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"
                                                          Fill="{StaticResource SuccessBrush}"
                                                          Width="14" Height="14"
                                                          Stretch="Uniform"
                                                          Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding CurrentUploadSpeed}"
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bandwidth Control Sliders -->
                                    <Grid Grid.Row="1" Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Download Limit -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                                      Fill="{StaticResource AccentPrimaryBrush}"
                                                      Width="16" Height="16"
                                                      Stretch="Uniform"
                                                      Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Network_Download}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <Slider Grid.Column="1"
                                                    Minimum="0" Maximum="{Binding SliderMaximum}"
                                                    Value="{Binding DownloadSliderValue, Mode=TwoWay}"
                                                    IsSnapToTickEnabled="True"
                                                    TickFrequency="1"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Margin="16,0"/>

                                            <Border Grid.Column="2"
                                                    Background="{Binding DownloadLimitBackground}"
                                                    CornerRadius="8"
                                                    Padding="12,6">
                                                <TextBlock Text="{Binding DownloadLimitText}"
                                                           Foreground="{Binding DownloadLimitForeground}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Upload Limit -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"
                                                      Fill="{StaticResource SuccessBrush}"
                                                      Width="16" Height="16"
                                                      Stretch="Uniform"
                                                      Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Network_Upload}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <Slider Grid.Column="1"
                                                    Minimum="0" Maximum="{Binding SliderMaximum}"
                                                    Value="{Binding UploadSliderValue, Mode=TwoWay}"
                                                    IsSnapToTickEnabled="True"
                                                    TickFrequency="1"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Margin="16,0"/>

                                            <Border Grid.Column="2"
                                                    Background="{Binding UploadLimitBackground}"
                                                    CornerRadius="8"
                                                    Padding="12,6">
                                                <TextBlock Text="{Binding UploadLimitText}"
                                                           Foreground="{Binding UploadLimitForeground}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- Per-Interface Traffic Chart -->
                                    <Border Grid.Row="2"
                                            Background="{StaticResource BgSecondaryBrush}"
                                            CornerRadius="12"
                                            Padding="12">
                                        <lvc:CartesianChart Series="{Binding ChartSeries}"
                                                            XAxes="{Binding XAxes}"
                                                            YAxes="{Binding YAxes}"
                                                            Background="Transparent"
                                                            AnimationsSpeed="0:0:0"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Per-app limits & blocks -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource BW_AppRulesTitle}"
                                       Style="{StaticResource SubHeaderTextStyle}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    x:Name="ResetAllButton"
                                    Content="{DynamicResource BW_ResetAll}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="12,6"
                                    Click="ResetAll_Click"/>
                        </Grid>

                        <TextBlock x:Name="AppRulesEmptyText"
                                   Text="{DynamicResource BW_AppRulesEmpty}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        <ItemsControl x:Name="AppRulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgTertiaryBrush}"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"/>
                                                <TextBlock Text="{Binding NowText}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                <Border Background="{StaticResource DangerBrush}"
                                                        CornerRadius="4"
                                                        Padding="8,3"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding BlockedVisibility}">
                                                    <TextBlock Text="{DynamicResource BW_BlockedPermanent}"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding LimitText}"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{DynamicResource BW_Unblock}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0"
                                                        Tag="{Binding Name}"
                                                        Visibility="{Binding BlockedVisibility}"
                                                        Click="UnblockApp_Click"/>
                                                <Button Content="{DynamicResource BW_Remove}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="10,4"
                                                        Tag="{Binding Name}"
                                                        Click="RemoveAppRule_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- How it works -->
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource BW_HowTitle}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource BW_HowText}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
