<Page x:Class="NetX.App.Views.BandwidthControlView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Bandwidth Control"
      Background="{StaticResource BgPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource Bandwidth_Title}"
                       Style="{StaticResource HeaderTextStyle}"
                       FontSize="28"/>
            <TextBlock Text="Control and limit bandwidth for applications"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Mode Selection -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Basic Mode Card -->
            <Border Grid.Column="0"
                    x:Name="BasicModeCard"
                    Style="{StaticResource StatCardStyle}"
                    Cursor="Hand"
                    MouseLeftButtonDown="BasicMode_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="BasicModeRadio"
                                     GroupName="ControlMode"
                                     IsChecked="True"
                                     Checked="Mode_Changed"/>
                        <TextBlock Text="{DynamicResource Bandwidth_BasicMode}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{DynamicResource Bandwidth_BasicDesc}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Features:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="• Block applications via Windows Firewall" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="• Limit download/upload speed" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="• Schedule-based rules" Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="4"
                            Padding="8,4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Recommended" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Advanced Mode Card -->
            <Border Grid.Column="2"
                    x:Name="AdvancedModeCard"
                    Style="{StaticResource StatCardStyle}"
                    Cursor="Hand"
                    MouseLeftButtonDown="AdvancedMode_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="AdvancedModeRadio"
                                     GroupName="ControlMode"
                                     Checked="Mode_Changed"/>
                        <TextBlock Text="{DynamicResource Bandwidth_AdvancedMode}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{DynamicResource Bandwidth_AdvancedDesc}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Features:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="• Kernel-level packet filtering (WFP)" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="• Cannot be bypassed by any application" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="• Per-connection control" Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Background="{StaticResource WarningBrush}"
                            CornerRadius="4"
                            Padding="8,4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Requires Admin" FontWeight="SemiBold" FontSize="11" Foreground="Black"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Rules Section -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Rules Header -->
            <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Bandwidth_Rules}"
                               Style="{StaticResource SubHeaderTextStyle}"/>

                    <Button Grid.Column="1"
                            Content="{DynamicResource Bandwidth_AddRule}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddRule_Click"/>
                </Grid>
            </Border>

            <!-- Rules List -->
            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column Headers -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BgSecondaryBrush}"
                            CornerRadius="12,12,0,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Application" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Download Limit" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Upload Limit" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Actions" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Rules ListView -->
                    <ListView Grid.Row="1"
                              x:Name="RulesList"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="16,12"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0dffffff"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Width="32" Height="32"
                                                CornerRadius="6"
                                                Background="{StaticResource BgTertiaryBrush}"
                                                Margin="0,0,12,0">
                                            <Image Source="{Binding Icon}" Width="20" Height="20"/>
                                        </Border>
                                        <TextBlock Text="{Binding ProcessName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DownloadLimit}"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding UploadLimit}"
                                               Foreground="{StaticResource SuccessBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               VerticalAlignment="Center"/>

                                    <Border Grid.Column="3"
                                            Background="{Binding StatusColor}"
                                            CornerRadius="10"
                                            Padding="8,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Content="Edit"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4"
                                                Margin="0,0,4,0"
                                                Click="EditRule_Click"/>
                                        <Button Content="X"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="8,4"
                                                Click="DeleteRule_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyState"
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Visible">
                        <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M17.13,17C15.92,18.85 14.11,20.24 12,20.92C9.89,20.24 8.08,18.85 6.87,17C6.53,16.5 6.24,16 6,15.47C6,13.82 8.71,12.47 12,12.47C15.29,12.47 18,13.79 18,15.47C17.76,16 17.47,16.5 17.13,17Z"
                              Fill="{StaticResource TextTertiaryBrush}"
                              Width="64" Height="64"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,16"/>
                        <TextBlock Text="No bandwidth rules configured"
                                   Style="{StaticResource BodyTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Add Rule' to create your first rule"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
