<Page x:Class="NetX.App.Views.RamOptimizerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="RAM Optimizer"
      Background="Transparent">

    <Page.Resources>
        <Geometry x:Key="CleanIcon">M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z</Geometry>
        <Geometry x:Key="KillIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="HistoryIcon">M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3</Geometry>
        <Geometry x:Key="ShieldIcon">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M17.13,17C15.92,18.85 14.11,20.24 12,20.92C9.89,20.24 8.08,18.85 6.87,17C6.53,16.5 6.24,16 6,15.47C6,13.82 8.71,12.47 12,12.47C15.29,12.47 18,13.79 18,15.47C17.76,16 17.47,16.5 17.13,17Z</Geometry>
        <Geometry x:Key="AddIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
        <Geometry x:Key="DeleteIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="AutoIcon">M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</Geometry>
        <Geometry x:Key="ListIcon">M3,4H7V8H3V4M9,5V7H21V5H9M3,10H7V14H3V10M9,11V13H21V11H9M3,16H7V20H3V16M9,17V19H21V17H9</Geometry>

        <Style x:Key="RamOptionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RamOptionDescStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="RamCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="RamValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="RamBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RamBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="6,2,0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RamColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RamRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RamToggleStyle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RamListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Margin="0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1affffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource RamOptimizer_Title}"
                       Style="{StaticResource HeaderTextStyle}"
                       FontSize="28"/>
            <TextBlock Text="{DynamicResource RamOptimizer_Subtitle}"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== Left: numbers, breakdown, chart, processes, activity ===================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stat cards -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,8,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RamOptimizer_TotalMemory}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TotalMemoryText" Text="–"
                                       Style="{StaticResource RamValueStyle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TotalCaption" Style="{StaticResource RamCaptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Margin="4,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RamOptimizer_UsedMemory}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="UsedMemoryText" Text="–"
                                       Style="{StaticResource RamValueStyle}"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock x:Name="UsedCaption" Style="{StaticResource RamCaptionStyle}"
                                       ToolTip="{DynamicResource Ram_CommitTip}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Margin="4,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RamOptimizer_AvailableMemory}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="AvailableMemoryText" Text="–"
                                       Style="{StaticResource RamValueStyle}"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock x:Name="FreeCaption" Style="{StaticResource RamCaptionStyle}"/>
                            <TextBlock x:Name="CacheCaption" Style="{StaticResource RamCaptionStyle}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource GlassCardStyle}" Margin="8,0,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RamOptimizer_Usage}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="UsagePercentText" Text="–"
                                       Style="{StaticResource RamValueStyle}"
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Where the RAM is (memory lists) -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ram_BreakdownTitle}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,10"/>

                        <StackPanel x:Name="BreakdownPanel">
                            <Border CornerRadius="6" Height="14" Background="{StaticResource BgTertiaryBrush}">
                                <Grid x:Name="BreakdownBar" SizeChanged="BreakdownBar_SizeChanged">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="SegInUseColumn" Width="1*"/>
                                        <ColumnDefinition x:Name="SegModifiedColumn" Width="0*"/>
                                        <ColumnDefinition x:Name="SegStandbyColumn" Width="0*"/>
                                        <ColumnDefinition x:Name="SegFreeColumn" Width="0*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource AccentPrimaryBrush}"/>
                                    <Border Grid.Column="1" Background="{StaticResource WarningBrush}"/>
                                    <Border Grid.Column="2" Background="{StaticResource InfoBrush}" Opacity="0.55"/>
                                    <Border Grid.Column="3" Background="{StaticResource SuccessBrush}"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0"
                                            Background="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Ram_SegInUse}" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    <TextBlock x:Name="SegInUseText" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0"
                                            Background="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Ram_SegModified}" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    <TextBlock x:Name="SegModifiedText" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0"
                                            Background="{StaticResource InfoBrush}" Opacity="0.55" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Ram_SegStandby}" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    <TextBlock x:Name="SegStandbyText" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="SegStandbyLowText" Margin="6,0,0,0" FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0"
                                            Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Ram_SegFree}" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    <TextBlock x:Name="SegFreeText" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="CompressedText" Margin="16,4,0,0"
                                           Visibility="Collapsed"
                                           Style="{StaticResource RamCaptionStyle}"
                                           ToolTip="{DynamicResource Ram_CompressedTip}"/>
                            </Grid>

                            <TextBlock Text="{DynamicResource Ram_BreakdownNote}"
                                       Style="{StaticResource RamOptionDescStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="BreakdownUnavailableText"
                                   Text="{DynamicResource Ram_DetailUnavailable}"
                                   Style="{StaticResource RamOptionDescStyle}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Usage history chart -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource RamOptimizer_MemoryHistory}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,8"/>

                        <lvc:CartesianChart Grid.Row="1"
                                            x:Name="MemoryChart"
                                            Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- Top memory consumers -->
                <Border Grid.Row="3" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource RamOptimizer_TopConsumers}"
                                       Style="{StaticResource SubHeaderTextStyle}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="RefreshBtn"
                                    Content="{DynamicResource Common_Refresh}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="12,6"
                                    Click="RefreshBtn_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="1" x:Name="ProcessActionText"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Grid Grid.Row="2" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Ram_ColProcess}"
                                       Style="{StaticResource RamColumnHeaderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Ram_ColMemory}"
                                       ToolTip="{DynamicResource Ram_ColMemoryTip}"
                                       Style="{StaticResource RamColumnHeaderStyle}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Ram_ColCommit}"
                                       ToolTip="{DynamicResource Ram_ColCommitTip}"
                                       Style="{StaticResource RamColumnHeaderStyle}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="3" MinHeight="120">
                            <ListView x:Name="ProcessList"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ItemContainerStyle="{StaticResource RamListItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                                   Source="{Binding Icon}"
                                                   Width="20" Height="20"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProcessName}"
                                                       ToolTip="{Binding DetailText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding MemoryText}"
                                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding PrivateMemoryText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource RamRowButtonStyle}"
                                                        Click="TrimProcess_Click"
                                                        IsEnabled="{Binding CanTrim}"
                                                        ToolTip="{Binding TrimToolTip}"
                                                        Margin="0,0,4,0">
                                                    <Path Data="{StaticResource CleanIcon}"
                                                          Fill="{StaticResource AccentPrimaryBrush}"
                                                          Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <Button Style="{StaticResource RamRowButtonStyle}"
                                                        Click="EndProcess_Click"
                                                        IsEnabled="{Binding CanEnd}"
                                                        ToolTip="{Binding EndToolTip}">
                                                    <Path Data="{StaticResource KillIcon}"
                                                          Fill="{StaticResource DangerBrush}"
                                                          Width="10" Height="10" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock x:Name="ProcessListMessage"
                                       Visibility="Collapsed"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Activity (cleanups + apps closed automatically) -->
                <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="{StaticResource HistoryIcon}"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource RamOptimizer_History}"
                                       Style="{StaticResource SubHeaderTextStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="HistoryEmptyText"
                                   Text="{DynamicResource Ram_HistoryEmpty}"
                                   Style="{StaticResource RamOptionDescStyle}"/>

                        <ListView x:Name="HistoryList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MaxHeight="420">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgTertiaryBrush}"
                                            CornerRadius="6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding TimeText}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding ResultText}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FreedText}"
                                                       Foreground="{Binding FreedBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       MaxWidth="150"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== Right: clean, options, automatic, protection ===================== -->
            <StackPanel Grid.Column="2">

                <!-- Clean now -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="20">
                    <StackPanel>
                        <Grid Width="120" Height="120" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Ellipse Width="120" Height="120"
                                     Stroke="{StaticResource BgTertiaryBrush}"
                                     StrokeThickness="12"/>
                            <Ellipse x:Name="MemoryGauge"
                                     Width="120" Height="120"
                                     Stroke="{StaticResource AccentGradientBrush}"
                                     StrokeThickness="12"
                                     StrokeDashArray="0 100"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="GaugePercentText" Text="–"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Ram_GaugeUsed}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="CleanNowBtn"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="24,12"
                                Click="CleanNowBtn_Click"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CleanIcon}"
                                      Fill="White"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock x:Name="CleanNowText"
                                           Text="{DynamicResource RamOptimizer_OptimizeNow}"
                                           FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="NotAdminBanner"
                                Visibility="Collapsed"
                                Margin="0,12,0,0" Padding="10,8" CornerRadius="6"
                                Background="#26F59E0B">
                            <TextBlock Text="{DynamicResource Ram_NotAdmin}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock x:Name="LastRunText"
                                   Text="{DynamicResource RamOptimizer_NeverOptimized}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>

                        <TextBlock x:Name="LastRunNotice"
                                   Visibility="Collapsed"
                                   FontSize="12"
                                   Foreground="{StaticResource WarningBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                        <TextBlock x:Name="LastRunSummary"
                                   Visibility="Collapsed"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                        <ItemsControl x:Name="LastRunOps" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}"
                                                   Foreground="{Binding GlyphBrush}"
                                                   FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- What to clean -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ListIcon}"
                                      Fill="{StaticResource AccentPrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Ram_WhatToClean}"
                                           Style="{StaticResource SubHeaderTextStyle}"/>
                            </StackPanel>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="8,4"
                                    FontSize="11"
                                    Click="UseSafeDefaults_Click"
                                    Content="{DynamicResource Ram_UseSafeDefaults}"/>
                        </Grid>

                        <!-- 1. Modified list -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <WrapPanel>
                                    <TextBlock Text="{DynamicResource Ram_OpFlushModified}" Style="{StaticResource RamOptionTitleStyle}"/>
                                    <Border Style="{StaticResource RamBadgeStyle}" Background="#2610B981">
                                        <TextBlock Text="{DynamicResource Ram_RiskSafe}" Style="{StaticResource RamBadgeTextStyle}" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource Ram_OpFlushModifiedDesc}" Style="{StaticResource RamOptionDescStyle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="OptFlushModified" Style="{StaticResource RamToggleStyle}" Click="CleanOption_Click"/>
                        </Grid>

                        <!-- 2. Low-priority standby -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <WrapPanel>
                                    <TextBlock Text="{DynamicResource Ram_OpLowStandby}" Style="{StaticResource RamOptionTitleStyle}"/>
                                    <Border Style="{StaticResource RamBadgeStyle}" Background="#2610B981">
                                        <TextBlock Text="{DynamicResource Ram_RiskSafe}" Style="{StaticResource RamBadgeTextStyle}" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource Ram_OpLowStandbyDesc}" Style="{StaticResource RamOptionDescStyle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="OptLowStandby" Style="{StaticResource RamToggleStyle}" Click="CleanOption_Click"/>
                        </Grid>

                        <!-- 3. Entire standby -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <WrapPanel>
                                    <TextBlock Text="{DynamicResource Ram_OpStandby}" Style="{StaticResource RamOptionTitleStyle}"/>
                                    <Border Style="{StaticResource RamBadgeStyle}" Background="#26F59E0B">
                                        <TextBlock Text="{DynamicResource Ram_RiskCaution}" Style="{StaticResource RamBadgeTextStyle}" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource Ram_OpStandbyDesc}" Style="{StaticResource RamOptionDescStyle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="OptStandby" Style="{StaticResource RamToggleStyle}" Click="CleanOption_Click"/>
                        </Grid>

                        <!-- 4. Combine pages -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <WrapPanel>
                                    <TextBlock Text="{DynamicResource Ram_OpCombine}" Style="{StaticResource RamOptionTitleStyle}"/>
                                    <Border Style="{StaticResource RamBadgeStyle}" Background="#26F59E0B">
                                        <TextBlock Text="{DynamicResource Ram_RiskCaution}" Style="{StaticResource RamBadgeTextStyle}" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource Ram_OpCombineDesc}" Style="{StaticResource RamOptionDescStyle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="OptCombine" Style="{StaticResource RamToggleStyle}" Click="CleanOption_Click"/>
                        </Grid>

                        <!-- 5. System file cache -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <WrapPanel>
                                    <TextBlock Text="{DynamicResource Ram_OpFileCache}" Style="{StaticResource RamOptionTitleStyle}"/>
                                    <Border Style="{StaticResource RamBadgeStyle}" Background="#26F59E0B">
                                        <TextBlock Text="{DynamicResource Ram_RiskCaution}" Style="{StaticResource RamBadgeTextStyle}" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource Ram_OpFileCacheDesc}" Style="{StaticResource RamOptionDescStyle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="OptFileCache" Style="{StaticResource RamToggleStyle}" Click="CleanOption_Click"/>
                        </Grid>

                        <!-- 6. Trim background apps -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <WrapPanel>
                                    <TextBlock Text="{DynamicResource Ram_OpTrim}" Style="{StaticResource RamOptionTitleStyle}"/>
                                    <Border Style="{StaticResource RamBadgeStyle}" Background="#26EF4444">
                                        <TextBlock Text="{DynamicResource Ram_RiskAggressive}" Style="{StaticResource RamBadgeTextStyle}" Foreground="{StaticResource DangerBrush}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource Ram_OpTrimDesc}" Style="{StaticResource RamOptionDescStyle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="OptTrim" Style="{StaticResource RamToggleStyle}" Click="CleanOption_Click"/>
                        </Grid>

                        <StackPanel x:Name="TrimExclusionsPanel" Visibility="Collapsed" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Ram_NeverTrim}" Style="{StaticResource RamOptionDescStyle}"/>
                            <TextBox x:Name="TrimExclusionsBox"
                                     Margin="0,4,0,0"
                                     Padding="8,6"
                                     FontSize="12"
                                     MaxLength="2000"
                                     LostKeyboardFocus="TrimExclusionsBox_LostKeyboardFocus"
                                     KeyDown="TrimExclusionsBox_KeyDown"/>
                            <TextBlock x:Name="TrimExclusionsStatus"
                                       Visibility="Collapsed"
                                       Style="{StaticResource RamOptionDescStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Automatic cleanup -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Path Data="{StaticResource AutoIcon}"
                                  Fill="{StaticResource AccentPrimaryBrush}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource RamOptimizer_Settings}"
                                       Style="{StaticResource SubHeaderTextStyle}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource RamOptimizer_AutoOptimize}" Style="{StaticResource RamOptionTitleStyle}"/>
                            <CheckBox Grid.Column="1" x:Name="AutoCleanToggle" Style="{StaticResource RamToggleStyle}" Click="AutoCleanToggle_Click"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Ram_AutoDesc}" Style="{StaticResource RamOptionDescStyle}" Margin="0,2,0,14"/>

                        <!-- Condition 1: memory load -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource RamOptimizer_Threshold}" Style="{StaticResource RamOptionTitleStyle}"/>
                            <TextBlock Grid.Column="1" x:Name="ThresholdText"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,12,0"/>
                            <CheckBox Grid.Column="2" x:Name="TriggerLoadToggle" Style="{StaticResource RamToggleStyle}" Click="TriggerToggle_Click"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Ram_AutoOnLoadDesc}" Style="{StaticResource RamOptionDescStyle}"/>
                        <Slider x:Name="ThresholdSlider"
                                Minimum="50" Maximum="95" Value="80"
                                SmallChange="1" LargeChange="5"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,6,0,16"
                                ValueChanged="SettingSlider_ValueChanged"/>

                        <!-- Condition 2: ISLC style -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Ram_AutoOnLowFree}" Style="{StaticResource RamOptionTitleStyle}"/>
                            <CheckBox Grid.Column="1" x:Name="TriggerLowFreeToggle" Style="{StaticResource RamToggleStyle}" Click="TriggerToggle_Click"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Ram_AutoOnLowFreeDesc}" Style="{StaticResource RamOptionDescStyle}"/>

                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource Ram_FreeBelow}" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                            <TextBlock x:Name="LowFreeText" HorizontalAlignment="Right"
                                       Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                        </Grid>
                        <Slider x:Name="LowFreeSlider"
                                Minimum="256" Maximum="8192" Value="1024"
                                SmallChange="256" LargeChange="1024"
                                TickFrequency="256" IsSnapToTickEnabled="True"
                                Margin="0,4,0,6"
                                ValueChanged="SettingSlider_ValueChanged"/>

                        <Grid>
                            <TextBlock Text="{DynamicResource Ram_CacheAtLeast}" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                            <TextBlock x:Name="MinStandbyText" HorizontalAlignment="Right"
                                       Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                        </Grid>
                        <Slider x:Name="MinStandbySlider"
                                Minimum="256" Maximum="8192" Value="1024"
                                SmallChange="256" LargeChange="1024"
                                TickFrequency="256" IsSnapToTickEnabled="True"
                                Margin="0,4,0,16"
                                ValueChanged="SettingSlider_ValueChanged"/>

                        <!-- Cooldown -->
                        <Grid>
                            <TextBlock Text="{DynamicResource Ram_AutoCooldown}" Style="{StaticResource BodyTextStyle}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,70,0"/>
                            <TextBlock x:Name="CooldownText" HorizontalAlignment="Right"
                                       Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                        </Grid>
                        <Slider x:Name="CooldownSlider"
                                Minimum="1" Maximum="120" Value="10"
                                SmallChange="1" LargeChange="10"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,4,0,0"
                                ValueChanged="SettingSlider_ValueChanged"/>

                        <TextBlock x:Name="AutoNoTriggerText"
                                   Text="{DynamicResource Ram_AutoNoTrigger}"
                                   Visibility="Collapsed"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Process protection (Smart Kill / Auto Kill) -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="{StaticResource ShieldIcon}"
                                  Fill="{StaticResource AccentPrimaryBrush}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource RamOptimizer_ProcessProtection}"
                                       Style="{StaticResource SubHeaderTextStyle}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource RamOptimizer_SmartKill}" Style="{StaticResource RamOptionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource RamOptimizer_SmartKillDesc}" Style="{StaticResource RamOptionDescStyle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="SmartKillToggle" Style="{StaticResource RamToggleStyle}" Click="SmartKillToggle_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource RamOptimizer_AutoKill}" Style="{StaticResource RamOptionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource RamOptimizer_AutoKillDesc}" Style="{StaticResource RamOptionDescStyle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="AutoKillToggle" Style="{StaticResource RamToggleStyle}" Click="AutoKillToggle_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource RamOptimizer_KillRules}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="8,4"
                                    Click="AddKillRule_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource AddIcon}"
                                          Fill="{StaticResource AccentPrimaryBrush}"
                                          Width="12" Height="12" Stretch="Uniform"
                                          Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource Common_Add}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8" MaxHeight="140">
                            <Grid>
                                <ListView x:Name="KillRulesList"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="4">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="border"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}"
                                                                Margin="0,1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#15ffffff"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ProcessName}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding KillCountText}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="4,2"
                                                        Click="RemoveKillRule_Click"
                                                        Tag="{Binding ProcessName}">
                                                    <Path Data="{StaticResource DeleteIcon}"
                                                          Fill="{StaticResource DangerBrush}"
                                                          Width="10" Height="10" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="KillRulesEmptyText"
                                           Text="{DynamicResource Ram_KillRulesEmpty}"
                                           Visibility="Collapsed"
                                           FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="12,10"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
