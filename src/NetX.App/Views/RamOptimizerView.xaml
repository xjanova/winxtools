<Page x:Class="NetX.App.Views.RamOptimizerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="RAM Optimizer"
      Background="Transparent">

    <Page.Resources>
        <Geometry x:Key="OptimizeIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="MemoryIcon">M17,17H7V7H17M21,11V9H19V7C19,5.89 18.1,5 17,5H15V3H13V5H11V3H9V5H7C5.89,5 5,5.89 5,7V9H3V11H5V13H3V15H5V17A2,2 0 0,0 7,19H9V21H11V19H13V21H15V19H17A2,2 0 0,0 19,17V15H21V13H19V11M13,13H11V11H13M15,9H9V15H15V9Z</Geometry>
        <Geometry x:Key="KillIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="HistoryIcon">M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3</Geometry>
        <Geometry x:Key="ShieldIcon">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M17.13,17C15.92,18.85 14.11,20.24 12,20.92C9.89,20.24 8.08,18.85 6.87,17C6.53,16.5 6.24,16 6,15.47C6,13.82 8.71,12.47 12,12.47C15.29,12.47 18,13.79 18,15.47C17.76,16 17.47,16.5 17.13,17Z</Geometry>
        <Geometry x:Key="AutoKillIcon">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z</Geometry>
        <Geometry x:Key="SmartKillIcon">M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z</Geometry>
        <Geometry x:Key="AddIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
        <Geometry x:Key="DeleteIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="FrozenIcon">M20.79,13.95L18.46,14.57L16.46,13.44V10.56L18.46,9.43L20.79,10.05L21.31,8.12L19.54,7.65L20,5.88L18.07,5.36L17.45,7.69L15.45,8.82L13,7.38V5.12L14.71,3.41L13.29,2L12,3.29L10.71,2L9.29,3.41L11,5.12V7.38L8.5,8.82L6.5,7.69L5.92,5.36L4,5.88L4.47,7.65L2.7,8.12L3.22,10.05L5.55,9.43L7.55,10.56V13.45L5.55,14.58L3.22,13.96L2.7,15.89L4.47,16.36L4,18.12L5.93,18.64L6.55,16.31L8.55,15.18L11,16.62V18.88L9.29,20.59L10.71,22L12,20.71L13.29,22L14.71,20.59L13,18.88V16.62L15.5,15.17L17.5,16.3L18.12,18.63L20,18.12L19.53,16.35L21.3,15.88L20.79,13.95M9.5,10.56L12,9.11L14.5,10.56V13.44L12,14.89L9.5,13.44V10.56Z</Geometry>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource RamOptimizer_Title}"
                       Style="{StaticResource HeaderTextStyle}"
                       FontSize="28"/>
            <TextBlock Text="{DynamicResource RamOptimizer_Subtitle}"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Charts and Process List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Memory Stats Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Memory -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,8,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RamOptimizer_TotalMemory}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TotalMemoryText" Text="0 GB"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Used Memory -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Margin="4,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RamOptimizer_UsedMemory}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="UsedMemoryText" Text="0 GB"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Available Memory -->
                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Margin="4,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RamOptimizer_AvailableMemory}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="AvailableMemoryText" Text="0 GB"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Usage Percent -->
                    <Border Grid.Column="3" Style="{StaticResource GlassCardStyle}" Margin="8,0,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RamOptimizer_Usage}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="UsagePercentText" Text="0%"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Memory Usage Chart -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource RamOptimizer_MemoryHistory}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,8"/>

                        <lvc:CartesianChart Grid.Row="1"
                                            x:Name="MemoryChart"
                                            Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- Top Memory Consumers -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource RamOptimizer_TopConsumers}"
                                       Style="{StaticResource SubHeaderTextStyle}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="RefreshBtn"
                                    Content="{DynamicResource Common_Refresh}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="12,6"
                                    Click="RefreshBtn_Click"/>
                        </Grid>

                        <ListView Grid.Row="1"
                                  x:Name="ProcessList"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="8"
                                                        Margin="0,2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1affffff"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Process Icon -->
                                        <Image Grid.Column="0"
                                               Source="{Binding Icon}"
                                               Width="20" Height="20"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                        <!-- Process Name -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProcessName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Working Set -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MemoryText}"
                                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>

                                        <!-- Private Memory -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PrivateMemoryText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="5,4"
                                                    Click="OptimizeProcess_Click"
                                                    Tag="{Binding ProcessId}"
                                                    ToolTip="Optimize Memory"
                                                    Margin="0,0,4,0">
                                                <Path Data="{StaticResource OptimizeIcon}"
                                                      Fill="{StaticResource AccentPrimaryBrush}"
                                                      Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="5,4"
                                                    Click="KillProcess_Click"
                                                    Tag="{Binding ProcessId}"
                                                    ToolTip="End Process">
                                                <Path Data="{StaticResource KillIcon}"
                                                      Fill="{StaticResource DangerBrush}"
                                                      Width="10" Height="10" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Panel: Controls and History -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Quick Optimize Button -->
                <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Memory Gauge -->
                        <Grid Grid.Row="0" Height="120" Margin="0,0,0,16">
                            <Ellipse Width="120" Height="120"
                                     Stroke="{StaticResource BgTertiaryBrush}"
                                     StrokeThickness="12"/>
                            <Ellipse x:Name="MemoryGauge"
                                     Width="120" Height="120"
                                     Stroke="{StaticResource AccentGradientBrush}"
                                     StrokeThickness="12"
                                     StrokeDashArray="2.5 0.5"
                                     StrokeDashOffset="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="GaugePercentText" Text="0%"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Used"
                                           FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Button Grid.Row="1"
                                x:Name="OptimizeNowBtn"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="24,12"
                                Click="OptimizeNowBtn_Click"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource OptimizeIcon}"
                                      Fill="White"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource RamOptimizer_OptimizeNow}"
                                           FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Row="2"
                                   x:Name="LastOptimizeText"
                                   Text="{DynamicResource RamOptimizer_NeverOptimized}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <!-- Settings -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource RamOptimizer_Settings}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,16"/>

                        <!-- Auto Optimize Toggle -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource RamOptimizer_AutoOptimize}"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoOptimizeToggle"
                                      HorizontalAlignment="Right"
                                      Click="AutoOptimizeToggle_Click"/>
                        </Grid>

                        <!-- Threshold Slider -->
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource RamOptimizer_Threshold}"
                                           Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock x:Name="ThresholdText" Text="80%"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="ThresholdSlider"
                                    Minimum="50" Maximum="95" Value="80"
                                    ValueChanged="ThresholdSlider_ValueChanged"/>
                        </StackPanel>

                        <!-- Interval Slider -->
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource RamOptimizer_Interval}"
                                           Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock x:Name="IntervalText" Text="30 min"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="IntervalSlider"
                                    Minimum="5" Maximum="120" Value="30"
                                    ValueChanged="IntervalSlider_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Process Protection Section -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="{StaticResource ShieldIcon}"
                                  Fill="{StaticResource AccentPrimaryBrush}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource RamOptimizer_ProcessProtection}"
                                       Style="{StaticResource SubHeaderTextStyle}"/>
                        </StackPanel>

                        <!-- Smart Kill Toggle (Frozen Process Detection) -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource RamOptimizer_SmartKill}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource RamOptimizer_SmartKillDesc}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="11"/>
                            </StackPanel>
                            <CheckBox x:Name="SmartKillToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Click="SmartKillToggle_Click"/>
                        </Grid>

                        <!-- Auto Kill Toggle -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource RamOptimizer_AutoKill}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource RamOptimizer_AutoKillDesc}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="11"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoKillToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Click="AutoKillToggle_Click"/>
                        </Grid>

                        <!-- Kill Rules List Header -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource RamOptimizer_KillRules}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="8,4"
                                    Click="AddKillRule_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource AddIcon}"
                                          Fill="{StaticResource AccentPrimaryBrush}"
                                          Width="12" Height="12" Stretch="Uniform"
                                          Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource Common_Add}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Kill Rules ListView -->
                        <Border Background="{StaticResource BgTertiaryBrush}"
                                CornerRadius="8"
                                MaxHeight="120">
                            <ListView x:Name="KillRulesList"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="4">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}"
                                                            Margin="0,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#15ffffff"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ProcessName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding KillCountText}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="4,2"
                                                    Click="RemoveKillRule_Click"
                                                    Tag="{Binding ProcessName}">
                                                <Path Data="{StaticResource DeleteIcon}"
                                                      Fill="{StaticResource DangerBrush}"
                                                      Width="10" Height="10" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Optimization History -->
                <Border Grid.Row="3" Style="{StaticResource GlassCardStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="{StaticResource HistoryIcon}"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource RamOptimizer_History}"
                                       Style="{StaticResource SubHeaderTextStyle}"/>
                        </StackPanel>

                        <ListView Grid.Row="1"
                                  x:Name="HistoryList"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgTertiaryBrush}"
                                            CornerRadius="6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TimeText}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding ResultText}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FreedText}"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
