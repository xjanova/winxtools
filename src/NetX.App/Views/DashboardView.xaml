<Page x:Class="NetX.App.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Dashboard"
      Background="{StaticResource BgPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="{DynamicResource Dashboard_Title}"
                           Style="{StaticResource HeaderTextStyle}"
                           FontSize="28"/>
                <TextBlock Text="{DynamicResource AppTagline}"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Stats Cards Row -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Download Card -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Border Grid.Row="0"
                                Width="48" Height="48"
                                CornerRadius="12"
                                Background="{StaticResource AccentGradientBrush}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                            <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                  Fill="White"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   x:Name="DownloadSpeed"
                                   Text="0 MB/s"
                                   Style="{StaticResource StatValueStyle}"/>

                        <!-- Label -->
                        <TextBlock Grid.Row="2"
                                   Text="{DynamicResource Dashboard_TotalDownload}"
                                   Style="{StaticResource StatLabelStyle}"/>
                    </Grid>
                </Border>

                <!-- Upload Card -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Border Grid.Row="0"
                                Width="48" Height="48"
                                CornerRadius="12"
                                Background="{StaticResource SuccessGradientBrush}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                            <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"
                                  Fill="White"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   x:Name="UploadSpeed"
                                   Text="0 MB/s"
                                   Style="{StaticResource StatValueStyle}"/>

                        <!-- Label -->
                        <TextBlock Grid.Row="2"
                                   Text="{DynamicResource Dashboard_TotalUpload}"
                                   Style="{StaticResource StatLabelStyle}"/>
                    </Grid>
                </Border>

                <!-- Active Apps Card -->
                <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Border Grid.Row="0"
                                Width="48" Height="48"
                                CornerRadius="12"
                                Background="{StaticResource WarningBrush}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                            <Path Data="M6,2A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6M6,4H13V9H18V20H6V4M8,12V14H16V12H8M8,16V18H13V16H8Z"
                                  Fill="White"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   x:Name="ActiveAppsCount"
                                   Text="0"
                                   Style="{StaticResource StatValueStyle}"/>

                        <!-- Label -->
                        <TextBlock Grid.Row="2"
                                   Text="{DynamicResource Dashboard_ActiveApps}"
                                   Style="{StaticResource StatLabelStyle}"/>
                    </Grid>
                </Border>

                <!-- Connections Card -->
                <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Border Grid.Row="0"
                                Width="48" Height="48"
                                CornerRadius="12"
                                Background="{StaticResource DangerGradientBrush}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                            <Path Data="M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.21,4.34 1.2,6.6L3,9C5.5,7.12 8.62,6 12,6C15.38,6 18.5,7.12 21,9L22.8,6.6C19.79,4.34 16.05,3 12,3M12,9C9.3,9 6.81,9.89 4.8,11.4L6.6,13.8C8.1,12.67 9.97,12 12,12C14.03,12 15.9,12.67 17.4,13.8L19.2,11.4C17.19,9.89 14.7,9 12,9Z"
                                  Fill="White"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   x:Name="ConnectionsCount"
                                   Text="0"
                                   Style="{StaticResource StatValueStyle}"/>

                        <!-- Label -->
                        <TextBlock Grid.Row="2"
                                   Text="{DynamicResource Dashboard_Connections}"
                                   Style="{StaticResource StatLabelStyle}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Charts and Top Consumers Row -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Real-time Traffic Chart -->
                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="250"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Dashboard_RealtimeTraffic}"
                                       Style="{StaticResource SubHeaderTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                <RadioButton x:Name="ChartLineBtn"
                                             Content="{DynamicResource Network_ChartLine}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             IsChecked="True"
                                             Checked="ChartType_Changed"
                                             Margin="0,0,12,0"/>
                                <RadioButton x:Name="ChartBarBtn"
                                             Content="{DynamicResource Network_ChartBar}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             Checked="ChartType_Changed"/>
                            </StackPanel>
                        </StackPanel>

                        <lvc:CartesianChart Grid.Row="1"
                                            x:Name="TrafficChart"
                                            Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- Top Consumers -->
                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{DynamicResource Dashboard_TopConsumers}"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,16"/>

                        <ListView Grid.Row="1"
                                  x:Name="TopConsumersList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="8"
                                                        Margin="0,2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1affffff"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                CornerRadius="6"
                                                Background="{StaticResource BgTertiaryBrush}"
                                                Margin="0,0,12,0">
                                            <Image Source="{Binding Icon}"
                                                   Width="20" Height="20"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Speed}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       FontSize="11"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Percentage}"
                                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Quick Actions Row -->
            <Border Grid.Row="3" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource Dashboard_QuickActions}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="{DynamicResource Dashboard_BlockAll}"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="BlockAll_Click"
                                Margin="0,0,12,0"/>

                        <Button Content="{DynamicResource Dashboard_ResumeAll}"
                                Style="{StaticResource SuccessButtonStyle}"
                                Click="ResumeAll_Click"
                                Margin="0,0,12,0"/>

                        <Button Content="{DynamicResource Dashboard_QuickClean}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="QuickClean_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
