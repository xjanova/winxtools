<Page x:Class="NetX.App.Views.SmartCpuView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Smart CPU"
      Background="Transparent">

    <Page.Resources>
        <Geometry x:Key="LeafIcon">M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z</Geometry>
        <Geometry x:Key="StopIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="PowerOffIcon">M16.56,5.44L15.11,6.89C16.84,7.94 18,9.83 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12C6,9.83 7.16,7.94 8.88,6.88L7.44,5.44C5.36,6.88 4,9.28 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12C20,9.28 18.64,6.88 16.56,5.44M13,3H11V13H13</Geometry>
        <Geometry x:Key="UninstallSmallIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>

        <Style x:Key="CpuRowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CpuToggle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SubHeaderTextStyle}">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="SmallNote" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="8" Margin="0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#14ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Cpu_Title}" Style="{StaticResource HeaderTextStyle}" FontSize="28"/>
                    <TextBlock Text="{DynamicResource Cpu_Subtitle}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Content="{DynamicResource Cpu_Refresh}" Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center" Click="Refresh_Click"/>
            </Grid>

            <!-- Stat cards -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,8,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cpu_StatBackground}" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="StatBackground" Text="–" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="StatBackgroundNote" Style="{StaticResource SmallNote}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Margin="4,0,4,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cpu_StatAutostart}" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="StatAutostart" Text="–" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="StatAutostartNote" Style="{StaticResource SmallNote}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Margin="4,0,4,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cpu_StatChrome}" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="StatChrome" Text="–" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="StatChromeNote" Style="{StaticResource SmallNote}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource GlassCardStyle}" Margin="8,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cpu_StatChanges}" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="StatChanges" Text="–" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="StatChangesNote" Style="{StaticResource SmallNote}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Background programs + side cards -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="460"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="370"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cpu_BackgroundTitle}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{DynamicResource Cpu_BackgroundDesc}" Style="{StaticResource SmallNote}" Margin="0,4,0,8"/>
                        <TextBlock x:Name="ActionText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="BackgroundState" Style="{StaticResource SmallNote}" FontSize="12" Margin="0,4,0,4"/>
                        <ListView x:Name="BackgroundList" ItemContainerStyle="{StaticResource RowItem}" Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="List_PreviewMouseWheel">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextPrimaryBrush}" MaxWidth="260"/>
                                                <Border Style="{StaticResource Badge}" Background="{Binding ClassBrush}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ClassText}" FontSize="10" FontWeight="SemiBold" Foreground="Black"/>
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Background="#3322c55e" Visibility="{Binding EfficiencyVisibility}">
                                                    <TextBlock Text="{DynamicResource Cpu_EfficiencyOn}" FontSize="10" Foreground="{StaticResource SuccessBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallNote}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                            <TextBlock Text="{Binding OriginText}" Style="{StaticResource SmallNote}" Foreground="{StaticResource AccentLightBrush}"
                                                       Visibility="{Binding OriginVisibility}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Foreground="{Binding CpuBrush}" HorizontalAlignment="Right" ToolTip="{DynamicResource Cpu_CpuTip}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding RamText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
                                            <Button Style="{StaticResource CpuRowButton}" Click="Efficiency_Click" IsEnabled="{Binding CanAct}"
                                                    ToolTip="{Binding EfficiencyTip}">
                                                <Path Data="{StaticResource LeafIcon}" Fill="{StaticResource SuccessBrush}" Width="13" Height="13" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource CpuRowButton}" Click="TurnOffOrigin_Click" IsEnabled="{Binding CanTurnOff}"
                                                    ToolTip="{Binding TurnOffTip}">
                                                <Path Data="{StaticResource PowerOffIcon}" Fill="{StaticResource WarningBrush}" Width="13" Height="13" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource CpuRowButton}" Click="End_Click" IsEnabled="{Binding CanAct}"
                                                    ToolTip="{DynamicResource Cpu_EndTip}">
                                                <Path Data="{StaticResource StopIcon}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource CpuRowButton}" Click="Uninstall_Click" IsEnabled="{Binding CanUninstall}"
                                                    ToolTip="{DynamicResource Cpu_UninstallTip}">
                                                <Path Data="{StaticResource UninstallSmallIcon}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- Chrome / Edge -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Cpu_BrowsersTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="BrowserState" Style="{StaticResource SmallNote}" FontSize="12" Margin="0,4,0,8"/>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="{DynamicResource Cpu_ChromeBackground}" Style="{StaticResource BodyTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,56,0"/>
                                <CheckBox x:Name="ChromeBackgroundToggle" Style="{StaticResource CpuToggle}" Click="BrowserToggle_Click" Tag="ChromeBackgroundMode"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Cpu_ChromeMemorySaver}" Style="{StaticResource BodyTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,56,0"/>
                                <CheckBox x:Name="ChromeMemoryToggle" Style="{StaticResource CpuToggle}" Click="BrowserToggle_Click" Tag="ChromeMemorySaver"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Cpu_EdgeBackground}" Style="{StaticResource BodyTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,56,0"/>
                                <CheckBox x:Name="EdgeBackgroundToggle" Style="{StaticResource CpuToggle}" Click="BrowserToggle_Click" Tag="EdgeBackgroundMode"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Cpu_EdgeStartupBoost}" Style="{StaticResource BodyTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,56,0"/>
                                <CheckBox x:Name="EdgeBoostToggle" Style="{StaticResource CpuToggle}" Click="BrowserToggle_Click" Tag="EdgeStartupBoost"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Cpu_EdgeEfficiency}" Style="{StaticResource BodyTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,56,0"/>
                                <CheckBox x:Name="EdgeEfficiencyToggle" Style="{StaticResource CpuToggle}" Click="BrowserToggle_Click" Tag="EdgeEfficiencyMode"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Cpu_ManagedNote}" Style="{StaticResource SmallNote}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Automatic efficiency -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource Cpu_AutoTitle}" Style="{StaticResource CardTitle}" Margin="0,0,56,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="AutoEfficiencyToggle" Style="{StaticResource CpuToggle}" Click="AutoEfficiency_Click"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Cpu_AutoDesc}" Style="{StaticResource SmallNote}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="AutoLog" Style="{StaticResource SmallNote}" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Changes made -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Cpu_ChangesTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="ChangesEmpty" Text="{DynamicResource Cpu_ChangesEmpty}" Style="{StaticResource SmallNote}" Margin="0,6,0,0"/>
                            <ItemsControl x:Name="ChangesList" Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallNote}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{DynamicResource Cpu_Undo}" Style="{StaticResource CpuRowButton}"
                                                    VerticalAlignment="Center" Click="Undo_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Everything that starts by itself -->
            <Border Grid.Row="3" Style="{StaticResource GlassCardStyle}" Padding="16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Cpu_AutostartTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{DynamicResource Cpu_AutostartDesc}" Style="{StaticResource SmallNote}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowWindowsItems" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ShowWindows_Click"
                                  Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock Text="{DynamicResource Cpu_ShowWindows}" FontSize="11"/>
                        </CheckBox>
                    </Grid>
                    <TextBlock x:Name="AutostartState" Style="{StaticResource SmallNote}" FontSize="12" Margin="0,8,0,4"/>
                    <ListView x:Name="AutostartList" ItemContainerStyle="{StaticResource RowItem}" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="List_PreviewMouseWheel">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}" MaxWidth="360"/>
                                            <Border Style="{StaticResource Badge}" Background="{Binding ClassBrush}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding ClassText}" FontSize="10" FontWeight="SemiBold" Foreground="Black"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{Binding StatusBrush}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="Black"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="#33f59e0b" Visibility="{Binding RecommendVisibility}">
                                                <TextBlock Text="{Binding RecommendText}" FontSize="10" Foreground="{StaticResource WarningBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallNote}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/>
                                        <TextBlock Text="{Binding Where}" Style="{StaticResource SmallNote}" Foreground="{StaticResource AccentLightBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Where}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ToggleText}" Style="{StaticResource CpuRowButton}" Click="AutostartToggle_Click"
                                            IsEnabled="{Binding CanToggle}" ToolTip="{Binding ToggleTip}" VerticalAlignment="Center" MinWidth="90"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
