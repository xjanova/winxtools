<Window x:Class="NetX.App.Views.RuleEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule Editor"
        Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Geometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="AddIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
        <Geometry x:Key="DeleteIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
    </Window.Resources>

    <Border Background="{StaticResource BgPrimaryBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondaryBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="Create New Rule"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="Close_Click"
                            HorizontalAlignment="Right"
                            Margin="0,0,10,0">
                        <Path Data="{StaticResource CloseIcon}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <!-- Basic Info -->
                    <TextBlock Text="Basic Information"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rule Name" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RuleNameBox" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Target Process (optional)" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ProcessNameBox" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Description" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                        <TextBox x:Name="DescriptionBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <!-- Conditions Section -->
                    <Border Background="{StaticResource BgSecondaryBrush}"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Conditions (When to trigger)"
                                           Style="{StaticResource SubHeaderTextStyle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox x:Name="ConditionLogicBox" Width="80" SelectedIndex="0">
                                        <ComboBoxItem Content="AND"/>
                                        <ComboBoxItem Content="OR"/>
                                    </ComboBox>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,6"
                                            Margin="10,0,0,0"
                                            Click="AddCondition_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource AddIcon}"
                                                  Fill="{StaticResource AccentPrimaryBrush}"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Add"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ItemsControl x:Name="ConditionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgTertiaryBrush}"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox Grid.Column="0"
                                                          SelectedValue="{Binding Type}"
                                                          SelectedValuePath="Tag"
                                                          Margin="0,0,8,0">
                                                    <ComboBoxItem Content="Time Range" Tag="TimeRange"/>
                                                    <ComboBoxItem Content="Day of Week" Tag="DayOfWeek"/>
                                                    <ComboBoxItem Content="Process Running" Tag="ProcessRunning"/>
                                                    <ComboBoxItem Content="Bandwidth Exceeds" Tag="BandwidthExceeds"/>
                                                    <ComboBoxItem Content="Connection Count" Tag="ConnectionCount"/>
                                                    <ComboBoxItem Content="IP Connected" Tag="IPConnected"/>
                                                    <ComboBoxItem Content="Port In Use" Tag="PortInUse"/>
                                                </ComboBox>

                                                <ComboBox Grid.Column="1"
                                                          SelectedValue="{Binding Operator}"
                                                          SelectedValuePath="Tag"
                                                          Margin="0,0,8,0">
                                                    <ComboBoxItem Content="=" Tag="Equals"/>
                                                    <ComboBoxItem Content="≠" Tag="NotEquals"/>
                                                    <ComboBoxItem Content="&gt;" Tag="GreaterThan"/>
                                                    <ComboBoxItem Content="&lt;" Tag="LessThan"/>
                                                    <ComboBoxItem Content="≥" Tag="GreaterOrEqual"/>
                                                    <ComboBoxItem Content="≤" Tag="LessOrEqual"/>
                                                </ComboBox>

                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Value}"
                                                         Style="{StaticResource ModernTextBoxStyle}"
                                                         Margin="0,0,8,0"/>

                                                <TextBox Grid.Column="3"
                                                         Text="{Binding Value2}"
                                                         Style="{StaticResource ModernTextBoxStyle}"
                                                         Margin="0,0,8,0"/>

                                                <Button Grid.Column="4"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8"
                                                        Click="RemoveCondition_Click"
                                                        Tag="{Binding}">
                                                    <Path Data="{StaticResource DeleteIcon}"
                                                          Fill="{StaticResource DangerBrush}"
                                                          Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoConditionsText"
                                       Text="No conditions added. Rule will always trigger."
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontStyle="Italic"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions Section -->
                    <Border Background="{StaticResource BgSecondaryBrush}"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Actions (What to do)"
                                           Style="{StaticResource SubHeaderTextStyle}"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6"
                                        HorizontalAlignment="Right"
                                        Click="AddAction_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource AddIcon}"
                                              Fill="{StaticResource AccentPrimaryBrush}"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Add"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl x:Name="ActionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgTertiaryBrush}"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox Grid.Column="0"
                                                          SelectedValue="{Binding Type}"
                                                          SelectedValuePath="Tag"
                                                          Margin="0,0,8,0">
                                                    <ComboBoxItem Content="Block IP" Tag="BlockIP"/>
                                                    <ComboBoxItem Content="Unblock IP" Tag="UnblockIP"/>
                                                    <ComboBoxItem Content="Block Port" Tag="BlockPort"/>
                                                    <ComboBoxItem Content="Limit Bandwidth" Tag="LimitBandwidth"/>
                                                    <ComboBoxItem Content="Write to Log" Tag="WriteToFile"/>
                                                    <ComboBoxItem Content="Show Notification" Tag="ShowNotification"/>
                                                    <ComboBoxItem Content="Send Webhook" Tag="SendWebhook"/>
                                                    <ComboBoxItem Content="LINE Notify" Tag="SendLineNotify"/>
                                                    <ComboBoxItem Content="Execute Command" Tag="ExecuteCommand"/>
                                                </ComboBox>

                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Target}"
                                                         Style="{StaticResource ModernTextBoxStyle}"
                                                         Margin="0,0,8,0"/>

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8"
                                                        Click="RemoveAction_Click"
                                                        Tag="{Binding}">
                                                    <Path Data="{StaticResource DeleteIcon}"
                                                          Fill="{StaticResource DangerBrush}"
                                                          Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoActionsText"
                                       Text="No actions added. Add at least one action."
                                       Foreground="{StaticResource DangerBrush}"
                                       FontStyle="Italic"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgSecondaryBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="20,0">
                <Grid>
                    <CheckBox x:Name="EnabledCheckBox"
                              Content="Enable this rule"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextSecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Cancel_Click"
                                Margin="0,0,10,0"
                                Padding="20,10"/>
                        <Button Content="Save Rule"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Save_Click"
                                Padding="20,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
