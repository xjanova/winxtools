<Window x:Class="NetX.App.Views.RuleEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RuleEditor_TitleNew}"
        Height="720" Width="860"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Geometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="AddIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
        <Geometry x:Key="DeleteIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>

        <!-- Small caption above each field -->
        <Style x:Key="FieldCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Day-of-week toggle chip -->
        <Style x:Key="DayChipStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip"
                                MinWidth="42"
                                Padding="8,9"
                                CornerRadius="8"
                                Background="{StaticResource SteelCardGradientBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgPrimaryBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondaryBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="{DynamicResource RuleEditor_TitleNew}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="Close_Click"
                            HorizontalAlignment="Right"
                            Margin="0,0,10,0">
                        <Path Data="{StaticResource CloseIcon}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <!-- Basic Info -->
                    <TextBlock Text="{DynamicResource RuleEditor_BasicInfo}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource RuleEditor_Name}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RuleNameBox" Style="{StaticResource ModernTextBoxStyle}" MaxLength="100"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource RuleEditor_TargetApp}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ProcessNameBox" Style="{StaticResource ModernTextBoxStyle}" MaxLength="128"/>
                            <TextBlock Text="{DynamicResource RuleEditor_TargetAppHint}"
                                       Style="{StaticResource FieldCaptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource RuleEditor_Description}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                            <TextBox x:Name="DescriptionBox"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Height="60"
                                     MaxLength="500"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource RuleEditor_Cooldown}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                            <TextBox x:Name="CooldownBox" Style="{StaticResource ModernTextBoxStyle}" MaxLength="6"/>
                            <TextBlock Text="{DynamicResource RuleEditor_CooldownHint}"
                                       Style="{StaticResource FieldCaptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Conditions Section -->
                    <Border Background="{StaticResource BgSecondaryBrush}"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource RuleEditor_Conditions}"
                                           Style="{StaticResource SubHeaderTextStyle}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox x:Name="ConditionLogicBox" Width="200" SelectedIndex="0">
                                        <ComboBoxItem Content="{DynamicResource RuleEditor_LogicAll}"/>
                                        <ComboBoxItem Content="{DynamicResource RuleEditor_LogicAny}"/>
                                    </ComboBox>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,6"
                                            Margin="10,0,0,0"
                                            Click="AddCondition_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource AddIcon}"
                                                  Fill="{StaticResource AccentPrimaryBrush}"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource Common_Add}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{DynamicResource RuleEditor_EdgeHint}"
                                       Style="{StaticResource FieldCaptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <ItemsControl x:Name="ConditionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgTertiaryBrush}"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="{DynamicResource RuleEditor_When}" Style="{StaticResource FieldCaptionStyle}"/>
                                                    <ComboBox SelectedValue="{Binding Type}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_CondTimeRange}" Tag="TimeRange"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_CondDayOfWeek}" Tag="DayOfWeek"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_CondProcessRunning}" Tag="ProcessRunning"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_CondBandwidth}" Tag="BandwidthExceeds"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_CondConnectionCount}" Tag="ConnectionCount"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_CondIpConnected}" Tag="IPConnected"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_CondPortInUse}" Tag="PortInUse"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_CondAlways}" Tag="Always"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Time range: from / to -->
                                                <Grid x:Name="TimeFields" Grid.Column="1" Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{DynamicResource RuleEditor_From}" Style="{StaticResource FieldCaptionStyle}"/>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="8"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{DynamicResource RuleEditor_To}" Style="{StaticResource FieldCaptionStyle}"/>
                                                        <TextBox Text="{Binding Value2, UpdateSourceTrigger=PropertyChanged}" MaxLength="8"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Day of week: one chip per day -->
                                                <StackPanel x:Name="DayFields" Grid.Column="1" Visibility="Collapsed">
                                                    <TextBlock Text="{DynamicResource RuleEditor_Days}" Style="{StaticResource FieldCaptionStyle}"/>
                                                    <WrapPanel>
                                                        <CheckBox Style="{StaticResource DayChipStyle}" Content="{DynamicResource RuleEditor_DayMon}" IsChecked="{Binding Monday}"/>
                                                        <CheckBox Style="{StaticResource DayChipStyle}" Content="{DynamicResource RuleEditor_DayTue}" IsChecked="{Binding Tuesday}"/>
                                                        <CheckBox Style="{StaticResource DayChipStyle}" Content="{DynamicResource RuleEditor_DayWed}" IsChecked="{Binding Wednesday}"/>
                                                        <CheckBox Style="{StaticResource DayChipStyle}" Content="{DynamicResource RuleEditor_DayThu}" IsChecked="{Binding Thursday}"/>
                                                        <CheckBox Style="{StaticResource DayChipStyle}" Content="{DynamicResource RuleEditor_DayFri}" IsChecked="{Binding Friday}"/>
                                                        <CheckBox Style="{StaticResource DayChipStyle}" Content="{DynamicResource RuleEditor_DaySat}" IsChecked="{Binding Saturday}"/>
                                                        <CheckBox Style="{StaticResource DayChipStyle}" Content="{DynamicResource RuleEditor_DaySun}" IsChecked="{Binding Sunday}"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Operator + one value -->
                                                <Grid x:Name="ValueFields" Grid.Column="1" Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text=" " Style="{StaticResource FieldCaptionStyle}"/>
                                                        <ComboBox x:Name="MatchOperatorBox"
                                                                  SelectedValue="{Binding MatchOperator}"
                                                                  SelectedValuePath="Tag">
                                                            <ComboBoxItem Content="=" Tag="Equals"/>
                                                            <ComboBoxItem Content="≠" Tag="NotEquals"/>
                                                        </ComboBox>
                                                        <ComboBox x:Name="CompareOperatorBox"
                                                                  SelectedValue="{Binding CompareOperator}"
                                                                  SelectedValuePath="Tag"
                                                                  Visibility="Collapsed">
                                                            <ComboBoxItem Content="&gt;" Tag="GreaterThan"/>
                                                            <ComboBoxItem Content="≥" Tag="GreaterOrEqual"/>
                                                            <ComboBoxItem Content="&lt;" Tag="LessThan"/>
                                                            <ComboBoxItem Content="≤" Tag="LessOrEqual"/>
                                                            <ComboBoxItem Content="=" Tag="Equals"/>
                                                            <ComboBoxItem Content="≠" Tag="NotEquals"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="ValueCaption" Style="{StaticResource FieldCaptionStyle}"/>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Always: nothing to fill in -->
                                                <TextBlock x:Name="AlwaysText"
                                                           Grid.Column="1"
                                                           Text="{DynamicResource RuleEditor_AlwaysHint}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Bottom"
                                                           Margin="0,0,0,10"
                                                           Visibility="Collapsed"/>

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Click="RemoveCondition_Click"
                                                        Tag="{Binding}"
                                                        ToolTip="{DynamicResource RuleEditor_Remove}">
                                                    <Path Data="{StaticResource DeleteIcon}"
                                                          Fill="{StaticResource DangerBrush}"
                                                          Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="TimeRange">
                                                <Setter TargetName="TimeFields" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="DayOfWeek">
                                                <Setter TargetName="DayFields" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="ProcessRunning">
                                                <Setter TargetName="ValueFields" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ValueCaption" Property="Text" Value="{DynamicResource RuleEditor_CapApp}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="BandwidthExceeds">
                                                <Setter TargetName="ValueFields" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="MatchOperatorBox" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="CompareOperatorBox" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ValueCaption" Property="Text" Value="{DynamicResource RuleEditor_CapSpeed}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="ConnectionCount">
                                                <Setter TargetName="ValueFields" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="MatchOperatorBox" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="CompareOperatorBox" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ValueCaption" Property="Text" Value="{DynamicResource RuleEditor_CapConnections}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="IPConnected">
                                                <Setter TargetName="ValueFields" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ValueCaption" Property="Text" Value="{DynamicResource RuleEditor_CapIpConnected}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="PortInUse">
                                                <Setter TargetName="ValueFields" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ValueCaption" Property="Text" Value="{DynamicResource RuleEditor_CapPort}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Always">
                                                <Setter TargetName="AlwaysText" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoConditionsText"
                                       Text="{DynamicResource RuleEditor_NoConditions}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontStyle="Italic"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions Section -->
                    <Border Background="{StaticResource BgSecondaryBrush}"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource RuleEditor_Actions}"
                                           Style="{StaticResource SubHeaderTextStyle}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6"
                                        HorizontalAlignment="Right"
                                        Click="AddAction_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource AddIcon}"
                                              Fill="{StaticResource AccentPrimaryBrush}"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Common_Add}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl x:Name="ActionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgTertiaryBrush}"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="{DynamicResource RuleEditor_Do}" Style="{StaticResource FieldCaptionStyle}"/>
                                                    <ComboBox SelectedValue="{Binding Type}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActBlockIP}" Tag="BlockIP"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActUnblockIP}" Tag="UnblockIP"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActBlockPort}" Tag="BlockPort"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActUnblockPort}" Tag="UnblockPort"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActLimitBandwidth}" Tag="LimitBandwidth"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActUnlimitBandwidth}" Tag="UnlimitBandwidth"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActKillProcess}" Tag="KillProcess"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActWriteToFile}" Tag="WriteToFile"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActShowNotification}" Tag="ShowNotification"/>
                                                        <ComboBoxItem Content="{DynamicResource RuleEditor_ActSendWebhook}" Tag="SendWebhook"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Main value: IP, port, speed, app, file or URL -->
                                                    <StackPanel x:Name="TargetField" Grid.Column="0" Grid.ColumnSpan="2">
                                                        <TextBlock x:Name="TargetCaption" Style="{StaticResource FieldCaptionStyle}"/>
                                                        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"/>
                                                    </StackPanel>

                                                    <!-- Second value: protocol, app or message -->
                                                    <StackPanel x:Name="ExtraField" Grid.Column="1" Margin="10,0,0,0" Visibility="Collapsed">
                                                        <TextBlock x:Name="ExtraCaption" Style="{StaticResource FieldCaptionStyle}"/>
                                                        <ComboBox x:Name="ProtocolBox"
                                                                  SelectedValue="{Binding Protocol}"
                                                                  SelectedValuePath="Content"
                                                                  Visibility="Collapsed">
                                                            <ComboBoxItem Content="TCP"/>
                                                            <ComboBoxItem Content="UDP"/>
                                                        </ComboBox>
                                                        <TextBox x:Name="ProcessBox"
                                                                 Text="{Binding Process, UpdateSourceTrigger=PropertyChanged}"
                                                                 MaxLength="128"
                                                                 Visibility="Collapsed"/>
                                                        <TextBox x:Name="MessageField"
                                                                 Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                                                 MaxLength="500"
                                                                 Visibility="Collapsed"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Click="RemoveAction_Click"
                                                        Tag="{Binding}"
                                                        ToolTip="{DynamicResource RuleEditor_Remove}">
                                                    <Path Data="{StaticResource DeleteIcon}"
                                                          Fill="{StaticResource DangerBrush}"
                                                          Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="BlockIP">
                                                <Setter TargetName="TargetCaption" Property="Text" Value="{DynamicResource RuleEditor_CapIpTarget}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="UnblockIP">
                                                <Setter TargetName="TargetCaption" Property="Text" Value="{DynamicResource RuleEditor_CapIpTarget}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="BlockPort">
                                                <Setter TargetName="TargetCaption" Property="Text" Value="{DynamicResource RuleEditor_CapPort}"/>
                                                <Setter TargetName="TargetField" Property="Grid.ColumnSpan" Value="1"/>
                                                <Setter TargetName="ExtraField" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ExtraCaption" Property="Text" Value="{DynamicResource RuleEditor_CapProtocol}"/>
                                                <Setter TargetName="ProtocolBox" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="UnblockPort">
                                                <Setter TargetName="TargetCaption" Property="Text" Value="{DynamicResource RuleEditor_CapPort}"/>
                                                <Setter TargetName="TargetField" Property="Grid.ColumnSpan" Value="1"/>
                                                <Setter TargetName="ExtraField" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ExtraCaption" Property="Text" Value="{DynamicResource RuleEditor_CapProtocol}"/>
                                                <Setter TargetName="ProtocolBox" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="LimitBandwidth">
                                                <Setter TargetName="TargetCaption" Property="Text" Value="{DynamicResource RuleEditor_CapLimit}"/>
                                                <Setter TargetName="TargetField" Property="Grid.ColumnSpan" Value="1"/>
                                                <Setter TargetName="ExtraField" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ExtraCaption" Property="Text" Value="{DynamicResource RuleEditor_CapAppOrPc}"/>
                                                <Setter TargetName="ProcessBox" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="UnlimitBandwidth">
                                                <Setter TargetName="TargetCaption" Property="Text" Value="{DynamicResource RuleEditor_CapAppOrPc}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="KillProcess">
                                                <Setter TargetName="TargetCaption" Property="Text" Value="{DynamicResource RuleEditor_CapApp}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="WriteToFile">
                                                <Setter TargetName="TargetCaption" Property="Text" Value="{DynamicResource RuleEditor_CapFileName}"/>
                                                <Setter TargetName="TargetField" Property="Grid.ColumnSpan" Value="1"/>
                                                <Setter TargetName="ExtraField" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ExtraCaption" Property="Text" Value="{DynamicResource RuleEditor_CapMessage}"/>
                                                <Setter TargetName="MessageField" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="ShowNotification">
                                                <Setter TargetName="TargetField" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="ExtraField" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ExtraField" Property="Grid.Column" Value="0"/>
                                                <Setter TargetName="ExtraField" Property="Grid.ColumnSpan" Value="2"/>
                                                <Setter TargetName="ExtraField" Property="Margin" Value="0"/>
                                                <Setter TargetName="ExtraCaption" Property="Text" Value="{DynamicResource RuleEditor_CapMessage}"/>
                                                <Setter TargetName="MessageField" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="SendWebhook">
                                                <Setter TargetName="TargetCaption" Property="Text" Value="{DynamicResource RuleEditor_CapUrl}"/>
                                                <Setter TargetName="TargetField" Property="Grid.ColumnSpan" Value="1"/>
                                                <Setter TargetName="ExtraField" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ExtraCaption" Property="Text" Value="{DynamicResource RuleEditor_CapMessage}"/>
                                                <Setter TargetName="MessageField" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoActionsText"
                                       Text="{DynamicResource RuleEditor_NoActions}"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontStyle="Italic"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgSecondaryBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="20,0">
                <Grid>
                    <CheckBox x:Name="EnabledCheckBox"
                              Content="{DynamicResource RuleEditor_Enable}"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextSecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Common_Cancel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Cancel_Click"
                                Margin="0,0,10,0"
                                Padding="20,10"/>
                        <Button Content="{DynamicResource RuleEditor_SaveRule}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Save_Click"
                                Padding="20,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
