    <system:String x:Key="CleanCat_Browser_Desc">Chrome, Edge, Brave, Opera, Vivaldi, Firefox — ลบเฉพาะแคช ไม่แตะรหัสผ่าน คุกกี้ ประวัติ หรือการล็อกอิน (ปิดเบราว์เซอร์ก่อนจะล้างได้หมด)</system:String>
    <system:String x:Key="CleanCat_Apps_Title">แคชของแอป</system:String>
