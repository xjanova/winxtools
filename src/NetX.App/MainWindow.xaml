        <Geometry x:Key="UninstallIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="CleanerIcon">M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z</Geometry>
        <Geometry x:Key="SettingsIcon">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</Geometry>
        <Geometry x:Key="RulesIcon">M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7Z</Geometry>
        <Geometry x:Key="PacketIcon">M12,3L2,12H5V20H19V12H22L12,3M12,8.5C14.34,8.5 16.46,9.43 18,10.94L16.8,12.12C15.58,10.91 13.88,10.17 12,10.17C10.12,10.17 8.42,10.91 7.2,12.12L6,10.94C7.54,9.43 9.66,8.5 12,8.5M12,11.83C13.4,11.83 14.67,12.39 15.6,13.3L14.4,14.47C13.79,13.87 12.94,13.5 12,13.5C11.06,13.5 10.21,13.87 9.6,14.47L8.4,13.3C9.33,12.39 10.6,11.83 12,11.83M12,15.17C12.94,15.17 13.7,15.91 13.7,16.83C13.7,17.75 12.94,18.5 12,18.5C11.06,18.5 10.3,17.75 10.3,16.83C10.3,15.91 11.06,15.17 12,15.17Z</Geometry>
        <Geometry x:Key="TricksIcon">M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z</Geometry>
        <Geometry x:Key="MinimizeIcon">M20,14H4V10H20</Geometry>
        <Geometry x:Key="MaximizeIcon">M4,4H20V20H4V4M6,8V18H18V8H6Z</Geometry>
        <Geometry x:Key="RestoreIcon">M4,8H8V4H20V16H16V20H4V8M16,8V14H18V6H10V8H16M6,12V18H14V12H6Z</Geometry>
        <Geometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
    </Window.Resources>

    <Border Background="{StaticResource BgPrimaryBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondaryBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinXTools"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}"/>
                        <TextBlock Text=" | "
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="4,0"/>
                        <TextBlock x:Name="CurrentPageTitle"
                                   Text="{DynamicResource Nav_Dashboard}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <Path Data="{StaticResource MinimizeIcon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize">
                            <Path x:Name="MaximizeIcon"
                                  Data="{StaticResource MaximizeIcon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Close">
                            <Path Data="{StaticResource CloseIcon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarGradientBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo Section -->
                        <StackPanel Grid.Row="0" Margin="20,24,20,20">
                            <TextBlock Text="WinXTools"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource AppTagline}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Navigation Buttons -->
                        <StackPanel Grid.Row="1" Margin="8,0">
                            <!-- Dashboard -->
                            <Button x:Name="NavDashboard"
                                    Style="{StaticResource NavButtonActiveStyle}"
                                    Click="NavButton_Click"
                                    Tag="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource HomeIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Dashboard}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Network Monitor -->
                            <Button x:Name="NavNetwork"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Network">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource NetworkIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_NetworkMonitor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Connection Monitor -->
                            <Button x:Name="NavConnections"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Connections">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ConnectionIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_ConnectionMonitor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Packet Monitor -->
                            <Button x:Name="NavPackets"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Packets">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource PacketIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_PacketMonitor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Bandwidth Control -->
                            <Button x:Name="NavBandwidth"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Bandwidth">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ControlIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_BandwidthControl}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Uninstaller -->
                            <Button x:Name="NavUninstaller"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Uninstaller">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource UninstallIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Uninstaller}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Cleaner -->
                            <Button x:Name="NavCleaner"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Cleaner">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource CleanerIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Cleaner}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="8,16" Background="{StaticResource BorderBrush}"/>

                            <!-- Automation Rules -->
                            <Button x:Name="NavRules"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Rules">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource RulesIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Rules}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Windows Tricks -->
                            <Button x:Name="NavTricks"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Tricks">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource TricksIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Tricks}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Settings -->
                            <Button x:Name="NavSettings"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SettingsIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Settings}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Footer with Sponsor Banner -->
                        <StackPanel Grid.Row="2" Margin="12,0,12,12">
                            <!-- Sponsor Banner - Elegant & Non-intrusive -->
                            <Border x:Name="SponsorBanner"
                                    Background="{StaticResource CardGradientBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,0,0,10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="SponsorBanner_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AuroraPurpleBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Animated Icon -->
                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            Background="{StaticResource AuroraPurplePinkBrush}"
                                            CornerRadius="8"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="AI"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.8" To="1" Duration="0:0:1.5"
                                                                         AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>

                                    <!-- Banner Text -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <Run Text="ThaiPrompt" Foreground="{StaticResource AuroraPurpleBrush}"/>
                                            <Run Text=".online" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="AI Tools for Everyone"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Separator Margin="0,0,0,8" Background="{StaticResource BorderBrush}"/>
                            <TextBlock Text="{DynamicResource AppCredit}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource AppVersion}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="9"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Area with Lava Lamp Background -->
                <Border Grid.Column="1"
                        Background="{StaticResource BgPrimaryBrush}"
                        CornerRadius="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Lava Lamp Animated Background -->
                        <Canvas Grid.Row="0" x:Name="LavaLampCanvas" ClipToBounds="True" IsHitTestVisible="False">
                            <!-- Blob 1 - Purple/Cyan -->
                            <Ellipse x:Name="LavaBlob1"
                                     Width="400" Height="400"
                                     Fill="{StaticResource LavaLamp1Brush}"
                                     Canvas.Left="-100" Canvas.Top="-100">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="Blob1Scale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="Blob1Translate"/>
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Blob1Translate"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="0" To="600" Duration="0:0:25"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Blob1Translate"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="0" To="400" Duration="0:0:20"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Blob1Scale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 From="1" To="1.3" Duration="0:0:15"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Blob1Scale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 From="1" To="1.2" Duration="0:0:18"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <!-- Blob 2 - Pink/Orange -->
                            <Ellipse x:Name="LavaBlob2"
                                     Width="350" Height="350"
                                     Fill="{StaticResource LavaLamp2Brush}"
                                     Canvas.Right="-50" Canvas.Bottom="-50">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="Blob2Scale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="Blob2Translate"/>
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Blob2Translate"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="0" To="-500" Duration="0:0:22"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Blob2Translate"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="0" To="-350" Duration="0:0:28"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Blob2Scale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 From="1" To="1.4" Duration="0:0:20"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Blob2Scale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 From="1" To="1.1" Duration="0:0:16"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <!-- Blob 3 - Cyan/Green -->
                            <Ellipse x:Name="LavaBlob3"
                                     Width="300" Height="300"
                                     Fill="{StaticResource LavaLamp3Brush}"
                                     Canvas.Left="200" Canvas.Top="150">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="Blob3Scale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="Blob3Translate"/>
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Blob3Translate"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="0" To="400" Duration="0:0:30"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Blob3Translate"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="0" To="200" Duration="0:0:25"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Blob3Scale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 From="1" To="1.2" Duration="0:0:18"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Blob3Scale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 From="1" To="1.35" Duration="0:0:22"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Canvas>

                        <!-- Main Content Frame -->
                        <Frame Grid.Row="0" x:Name="MainFrame"
                               NavigationUIVisibility="Hidden"
                               Background="Transparent"/>

                        <!-- Status Bar -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="12,6"
                                CornerRadius="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Download Speed -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                    <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                          Fill="{StaticResource AccentPrimaryBrush}"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="StatusDownload" Text="0 B/s"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Upload Speed -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,20,0">
                                    <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"
                                          Fill="{StaticResource SuccessBrush}"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="StatusUpload" Text="0 B/s"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Mini Bandwidth Bars -->
                                <Grid Grid.Column="2" Width="60" Height="16" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#20607080" CornerRadius="2">
                                        <Border x:Name="StatusDownloadBar"
                                                Background="{StaticResource AccentPrimaryBrush}"
                                                HorizontalAlignment="Left" CornerRadius="2"
                                                Width="0"/>
                                    </Border>
                                    <Border Grid.Column="2" Background="#20607080" CornerRadius="2">
                                        <Border x:Name="StatusUploadBar"
                                                Background="{StaticResource SuccessBrush}"
                                                HorizontalAlignment="Left" CornerRadius="2"
                                                Width="0"/>
                                    </Border>
                                </Grid>

                                <!-- Total Data -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="Total: "
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusTotalReceived" Text="0 B"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" / "
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusTotalSent" Text="0 B"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Connections -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,20,0">
                                    <Path Data="M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.21,4.34 1.2,6.6L3,9C5.5,7.12 8.62,6 12,6C15.38,6 18.5,7.12 21,9L22.8,6.6C19.79,4.34 16.05,3 12,3M12,9C9.3,9 6.81,9.89 4.8,11.4L6.6,13.8C8.1,12.67 9.97,12 12,12C14.03,12 15.9,12.67 17.4,13.8L19.2,11.4C17.19,9.89 14.7,9 12,9Z"
                                          Fill="{StaticResource TextTertiaryBrush}"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="StatusConnections" Text="0"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Active Processes -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <Path Data="M6,2A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6"
                                          Fill="{StaticResource TextTertiaryBrush}"
                                          Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="StatusProcesses" Text="0"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" apps"
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
