        <Geometry x:Key="MinimizeIcon">M20,14H4V10H20</Geometry>
        <Geometry x:Key="MaximizeIcon">M4,4H20V20H4V4M6,8V18H18V8H6Z</Geometry>
        <Geometry x:Key="RestoreIcon">M4,8H8V4H20V16H16V20H4V8M16,8V14H18V6H10V8H16M6,12V18H14V12H6Z</Geometry>
        <Geometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
    </Window.Resources>

    <Border Background="{StaticResource BgPrimaryBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondaryBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinXTools"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}"/>
                        <TextBlock Text=" | "
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="4,0"/>
                        <TextBlock x:Name="CurrentPageTitle"
                                   Text="{DynamicResource Nav_Dashboard}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <Path Data="{StaticResource MinimizeIcon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize">
                            <Path x:Name="MaximizeIcon"
                                  Data="{StaticResource MaximizeIcon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Close">
                            <Path Data="{StaticResource CloseIcon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation -->
                <Border Grid.Column="0"
                        Width="200"
                        Background="{StaticResource SidebarGradientBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Subtle Logo Watermark Background -->
                        <Image Grid.RowSpan="3"
                               Source="Assets/logo.png"
                               Opacity="0.03"
                               Stretch="Uniform"
                               Width="280"
                               Height="280"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,60,0,0"
                               IsHitTestVisible="False"/>

                        <!-- Logo Section -->
                        <Grid Grid.Row="0">
                            <!-- Logo Image - fills full width, no crop -->
                            <Image Source="Assets/logo.png"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top"
                                   Margin="0,10,0,0"/>

                            <!-- Fade effect at bottom -->
                            <Rectangle VerticalAlignment="Bottom" Height="40" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#0a1428" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <!-- Navigation Buttons with ScrollViewer -->
                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource ModernScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,0">
                            <!-- Dashboard -->
                            <Button x:Name="NavDashboard"
                                    Style="{StaticResource NavButtonActiveStyle}"
                                    Click="NavButton_Click"
                                    Tag="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource HomeIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Dashboard}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Network Monitor -->
                            <Button x:Name="NavNetwork"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Network">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource NetworkIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_NetworkMonitor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Bandwidth Control -->
                            <Button x:Name="NavBandwidth"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Bandwidth">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ControlIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_BandwidthControl}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Connection Monitor -->
                            <Button x:Name="NavConnections"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Connections">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ConnectionIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_ConnectionMonitor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Packet Monitor -->
                            <Button x:Name="NavPackets"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Packets">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource PacketIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_PacketMonitor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Network Tools -->
                            <Button x:Name="NavNetworkTools"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="NetworkTools">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ToolsIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_NetworkTools}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Proxy VPN -->
                            <Button x:Name="NavProxyVpn"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="ProxyVpn">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ProxyVpnIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_ProxyVpn}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- RAM Optimizer -->
                            <Button x:Name="NavRamOptimizer"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="RamOptimizer">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource RamIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_RamOptimizer}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Uninstaller -->
                            <Button x:Name="NavUninstaller"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Uninstaller">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource UninstallIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Uninstaller}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Cleaner -->
                            <Button x:Name="NavCleaner"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Cleaner">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource CleanerIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Cleaner}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Windows Optimizer -->
                            <Button x:Name="NavWinOptimizer"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="WinOptimizer">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource WinOptimizerIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_WinOptimizer}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="8,16" Background="{StaticResource BorderBrush}"/>

                            <!-- Automation Rules -->
                            <Button x:Name="NavRules"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Rules">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource RulesIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Rules}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Windows Tricks -->
                            <Button x:Name="NavTricks"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Tricks">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource TricksIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Tricks}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Settings -->
                            <Button x:Name="NavSettings"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="NavButton_Click"
                                    Tag="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SettingsIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <TextBlock Text="{DynamicResource Nav_Settings}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </ScrollViewer>

                        <!-- Footer with Pro Upgrade Banner -->
                        <StackPanel Grid.Row="2" Margin="12,0,12,12">
                            <!-- Pro Upgrade Banner - Gold Metallic -->
                            <Border x:Name="ProBanner"
                                    Background="{StaticResource GoldMetallicDarkBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,0,0,10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ProBanner_Click">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#fbbf24" Offset="0"/>
                                        <GradientStop Color="#92400e" Offset="0.4"/>
                                        <GradientStop Color="#fde68a" Offset="0.7"/>
                                        <GradientStop Color="#b45309" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.3" Color="#f59e0b"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.5" Color="#fbbf24"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Gold Crown Icon -->
                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="8"
                                            Margin="0,0,10,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#fde68a" Offset="0"/>
                                                <GradientStop Color="#f59e0b" Offset="0.5"/>
                                                <GradientStop Color="#d97706" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="&#x265B;"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#1a1505"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Banner Text -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ProBannerTitle" Text="{DynamicResource Pro_UpgradeTitle}"
                                                       FontSize="12" FontWeight="Bold">
                                                <TextBlock.Foreground>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#fef3c7" Offset="0"/>
                                                        <GradientStop Color="#fbbf24" Offset="0.5"/>
                                                        <GradientStop Color="#fde68a" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock x:Name="TrialCountdown"
                                                       FontSize="12" FontWeight="Bold"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Margin="8,0,0,0" Visibility="Collapsed">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="#fde68a"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock x:Name="ProBannerDesc" Text="{DynamicResource Pro_UpgradeDesc}"
                                                   FontSize="9"
                                                   Margin="0,2,0,0">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="#d4a254"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Arrow -->
                                    <TextBlock Grid.Column="2"
                                               Text="&#x276F;"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#fbbf24"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Separator Margin="0,0,0,8" Background="{StaticResource BorderBrush}"/>
                            <TextBlock Text="{DynamicResource AppCredit}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource AppVersion}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="9"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Area with Lava Lamp Background -->
                <Border Grid.Column="1"
                        Background="{StaticResource BgPrimaryBrush}"
                        CornerRadius="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Static Gradient Background (No Animation for Performance) -->
                        <Grid Grid.Row="0" IsHitTestVisible="False">
                            <!-- Subtle gradient blobs - static for performance -->
                            <Ellipse Width="400" Height="400"
                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Margin="-100,-100,0,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                        <GradientStop Color="#208b5cf6" Offset="0"/>
                                        <GradientStop Color="#1006b6d4" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="350" Height="350"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,-50,-50">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.7,0.7" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#18ec4899" Offset="0"/>
                                        <GradientStop Color="#08f59e0b" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="300" Height="300"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Margin="100,50,0,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.2" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#1506b6d4" Offset="0"/>
                                        <GradientStop Color="#0810b981" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <!-- Main Content Frame -->
                        <Frame Grid.Row="0" x:Name="MainFrame"
                               NavigationUIVisibility="Hidden"
                               Background="Transparent"/>

                        <!-- Pro Feature Overlay (darkens content when feature requires Pro) -->
                        <Grid x:Name="ProOverlay" Grid.Row="0" Visibility="Collapsed">
                            <Border Background="#CC0a0e1a" CornerRadius="0,0,12,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Gold Crown Circle -->
                                    <Border Width="80" Height="80" CornerRadius="40"
                                            HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#fde68a" Offset="0"/>
                                                <GradientStop Color="#f59e0b" Offset="0.5"/>
                                                <GradientStop Color="#d97706" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.4" Color="#f59e0b"/>
                                        </Border.Effect>
                                        <TextBlock Text="&#x265B;" FontSize="36" FontWeight="Bold"
                                                   Foreground="#1a1505"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Title -->
                                    <TextBlock Text="{DynamicResource Pro_OverlayTitle}"
                                               FontSize="24" FontWeight="Bold"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#fef3c7" Offset="0"/>
                                                <GradientStop Color="#fbbf24" Offset="0.5"/>
                                                <GradientStop Color="#fde68a" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <!-- Description -->
                                    <TextBlock Text="{DynamicResource Pro_OverlayDesc}"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,24">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#d4a254"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <!-- Upgrade Button -->
                                    <Border CornerRadius="8" Padding="24,12" Cursor="Hand"
                                            HorizontalAlignment="Center"
                                            MouseLeftButtonDown="ProOverlay_UpgradeClick">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#f59e0b" Offset="0"/>
                                                <GradientStop Color="#d97706" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.3" Color="#f59e0b"/>
                                        </Border.Effect>
                                        <TextBlock Text="{DynamicResource Pro_UpgradeButton}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="#1a1505"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Non-blocking notices (automatic actions such as Smart Kill) -->
                        <Border x:Name="ToastHost" Grid.Row="0"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,24,24" MaxWidth="440"
                                Padding="16,12" CornerRadius="10"
                                Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                Visibility="Collapsed"
                                Cursor="Hand"
                                MouseLeftButtonDown="ToastHost_Click">
                            <TextBlock x:Name="ToastText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>

                        <!-- Status Bar -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="12,6"
                                CornerRadius="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Download Speed -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                    <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                          Fill="{StaticResource AccentPrimaryBrush}"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="StatusDownload" Text="0 B/s"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Upload Speed -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                                    <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"
                                          Fill="{StaticResource SuccessBrush}"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="StatusUpload" Text="0 B/s"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Bandwidth Limit Status -->
                                <Border Grid.Column="2"
                                        x:Name="BandwidthLimitBadge"
                                        Background="{StaticResource BgTertiaryBrush}"
                                        CornerRadius="8"
                                        Padding="8,4"
                                        Margin="0,0,20,0"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12,16A3,3 0 0,1 9,13C9,11.88 9.61,10.9 10.5,10.39L20.21,4.77L14.68,14.35C14.18,15.33 13.17,16 12,16M12,3C13.81,3 15.5,3.5 16.97,4.32L14.87,5.53C14,5.19 13,5 12,5A8,8 0 0,0 4,13C4,15.21 4.89,17.21 6.34,18.65H6.35C6.74,19.04 6.74,19.67 6.35,20.06C5.96,20.45 5.32,20.45 4.93,20.07V20.07C3.12,18.26 2,15.76 2,13A10,10 0 0,1 12,3M22,13C22,15.76 20.88,18.26 19.07,20.07V20.07C18.68,20.45 18.05,20.45 17.66,20.06C17.27,19.67 17.27,19.04 17.66,18.65V18.65C19.11,17.2 20,15.21 20,13C20,12 19.81,11 19.46,10.1L20.67,8C21.5,9.5 22,11.18 22,13Z"
                                              Fill="{StaticResource WarningBrush}"
                                              Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Limit:"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock x:Name="StatusBandwidthLimit" Text=""
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mini Bandwidth Bars -->
                                <Grid Grid.Column="3" Width="60" Height="16" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#20607080" CornerRadius="2">
                                        <Border x:Name="StatusDownloadBar"
                                                Background="{StaticResource AccentPrimaryBrush}"
                                                HorizontalAlignment="Left" CornerRadius="2"
                                                Width="0"/>
                                    </Border>
                                    <Border Grid.Column="2" Background="#20607080" CornerRadius="2">
                                        <Border x:Name="StatusUploadBar"
                                                Background="{StaticResource SuccessBrush}"
                                                HorizontalAlignment="Left" CornerRadius="2"
                                                Width="0"/>
                                    </Border>
                                </Grid>

                                <!-- Total Data -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,20,0">
                                    <TextBlock Text="Total: "
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusTotalReceived" Text="0 B"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" / "
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusTotalSent" Text="0 B"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Connections -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,20,0">
                                    <Path Data="M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.21,4.34 1.2,6.6L3,9C5.5,7.12 8.62,6 12,6C15.38,6 18.5,7.12 21,9L22.8,6.6C19.79,4.34 16.05,3 12,3M12,9C9.3,9 6.81,9.89 4.8,11.4L6.6,13.8C8.1,12.67 9.97,12 12,12C14.03,12 15.9,12.67 17.4,13.8L19.2,11.4C17.19,9.89 14.7,9 12,9Z"
                                          Fill="{StaticResource TextTertiaryBrush}"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="StatusConnections" Text="0"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Active Processes -->
                                <StackPanel Grid.Column="6" Orientation="Horizontal">
                                    <Path Data="M6,2A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6"
                                          Fill="{StaticResource TextTertiaryBrush}"
                                          Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="StatusProcesses" Text="0"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" apps"
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
