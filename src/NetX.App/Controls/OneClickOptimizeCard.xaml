<UserControl x:Class="NetX.App.Controls.OneClickOptimizeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Geometry x:Key="BoltIcon">M11,15H6L13,1V9H18L11,23V15Z</Geometry>
        <Geometry x:Key="StopSquareIcon">M18,18H6V6H18V18Z</Geometry>

        <Style x:Key="BigRoundButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="face">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF00C8FF" Offset="0"/>
                                        <GradientStop Color="#FF2F6BFF" Offset="0.55"/>
                                        <GradientStop Color="#FF8A3DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00C8FF" BlurRadius="26" ShadowDepth="0" Opacity="0.75"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Margin="3" Stroke="#55FFFFFF" StrokeThickness="1.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="face" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="18" Padding="22" BorderThickness="1.5">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#9900C8FF" Offset="0"/>
                <GradientStop Color="#552F6BFF" Offset="0.5"/>
                <GradientStop Color="#998A3DFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2200C8FF" Offset="0"/>
                <GradientStop Color="#0C0A1428" Offset="0.5"/>
                <GradientStop Color="#228A3DFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The button with its rings -->
            <Grid Width="168" Height="168" VerticalAlignment="Top">
                <Ellipse x:Name="Glow" Width="150" Height="150" Fill="#4400C8FF" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <BlurEffect Radius="34"/>
                    </Ellipse.Effect>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="GlowScale"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="150" Height="150" Stroke="#22FFFFFF" StrokeThickness="7" IsHitTestVisible="False"/>
                <Ellipse x:Name="ProgressRing" Width="150" Height="150" StrokeThickness="7" StrokeDashArray="0 100" StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF00E5FF" Offset="0"/>
                            <GradientStop Color="#FF8A3DFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Spinner" Width="166" Height="166" Stroke="#9900E5FF" StrokeThickness="2" StrokeDashArray="3 9"
                         RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Button x:Name="GoButton" Width="120" Height="120" Style="{StaticResource BigRoundButton}" Click="Go_Click">
                    <StackPanel>
                        <Path x:Name="GoIcon" Data="{StaticResource BoltIcon}" Fill="White" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="GoText" Text="{DynamicResource OneClick_Go}" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- What it does, live steps, result -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource OneClick_Title}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="Subtitle" Text="{DynamicResource OneClick_Subtitle}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,10"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <ItemsControl x:Name="StepsList" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,6" Margin="0,0,8,8" Background="#14FFFFFF" MinWidth="150">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" FontSize="13" Width="18"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" MaxWidth="230"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="SummaryText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#10b981" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>

                <ItemsControl x:Name="SuggestionsList" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{StaticResource WarningBrush}"/>
                                <Button Grid.Column="1" Content="{Binding ActionText}" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,3" FontSize="11" Margin="10,0,0,0" Click="Suggestion_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
