<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- NetX Aurora Ocean Theme                        -->
    <!-- Beautiful Gradient + Lava Lamp Effects         -->
    <!-- by xman studio                                 -->
    <!-- ============================================== -->

    <!-- Primary Background Colors (Deep Aurora Ocean) -->
    <Color x:Key="BgPrimaryColor">#050a18</Color>
    <Color x:Key="BgSecondaryColor">#0a1428</Color>
    <Color x:Key="BgTertiaryColor">#101e38</Color>
    <Color x:Key="BgCardColor">#0d1830</Color>
    <Color x:Key="BgGlassColor">#150d1830</Color>

    <!-- Accent Colors (Aurora Ocean Cyan) -->
    <Color x:Key="AccentPrimaryColor">#00c8ff</Color>
    <Color x:Key="AccentSecondaryColor">#0090cc</Color>
    <Color x:Key="AccentTertiaryColor">#006090</Color>
    <Color x:Key="AccentLightColor">#60e0ff</Color>

    <!-- Aurora Colors (Purple-Pink-Cyan) -->
    <Color x:Key="AuroraPurpleColor">#8b5cf6</Color>
    <Color x:Key="AuroraPinkColor">#ec4899</Color>
    <Color x:Key="AuroraCyanColor">#06b6d4</Color>
    <Color x:Key="AuroraGreenColor">#10b981</Color>

    <!-- Steel Metallic Colors -->
    <Color x:Key="SteelLightColor">#94a3b8</Color>
    <Color x:Key="SteelMidColor">#64748b</Color>
    <Color x:Key="SteelDarkColor">#475569</Color>
    <Color x:Key="SteelHighlightColor">#cbd5e1</Color>

    <!-- Status Colors (Vibrant Neon) -->
    <Color x:Key="SuccessColor">#10b981</Color>
    <Color x:Key="WarningColor">#f59e0b</Color>
    <Color x:Key="DangerColor">#ef4444</Color>
    <Color x:Key="InfoColor">#06b6d4</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#f1f5f9</Color>
    <Color x:Key="TextSecondaryColor">#94a3b8</Color>
    <Color x:Key="TextTertiaryColor">#64748b</Color>
    <Color x:Key="TextDisabledColor">#475569</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#1e3a5f</Color>
    <Color x:Key="BorderHoverColor">#2d4a6f</Color>
    <Color x:Key="BorderActiveColor">#00c8ff</Color>

    <!-- ============================================== -->
    <!-- Solid Color Brushes                           -->
    <!-- ============================================== -->

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="BgTertiaryBrush" Color="{StaticResource BgTertiaryColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgGlassBrush" Color="{StaticResource BgGlassColor}"/>

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentTertiaryBrush" Color="{StaticResource AccentTertiaryColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>

    <SolidColorBrush x:Key="AuroraPurpleBrush" Color="{StaticResource AuroraPurpleColor}"/>
    <SolidColorBrush x:Key="AuroraPinkBrush" Color="{StaticResource AuroraPinkColor}"/>
    <SolidColorBrush x:Key="AuroraCyanBrush" Color="{StaticResource AuroraCyanColor}"/>
    <SolidColorBrush x:Key="AuroraGreenBrush" Color="{StaticResource AuroraGreenColor}"/>

    <SolidColorBrush x:Key="SteelLightBrush" Color="{StaticResource SteelLightColor}"/>
    <SolidColorBrush x:Key="SteelMidBrush" Color="{StaticResource SteelMidColor}"/>
    <SolidColorBrush x:Key="SteelDarkBrush" Color="{StaticResource SteelDarkColor}"/>
    <SolidColorBrush x:Key="SteelHighlightBrush" Color="{StaticResource SteelHighlightColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
    <SolidColorBrush x:Key="BorderActiveBrush" Color="{StaticResource BorderActiveColor}"/>

    <!-- ============================================== -->
    <!-- Beautiful Aurora Gradient Brushes             -->
    <!-- ============================================== -->

    <!-- Accent Gradient (Ocean Cyan Aurora) -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#60e0ff" Offset="0"/>
        <GradientStop Color="#00c8ff" Offset="0.3"/>
        <GradientStop Color="#0090cc" Offset="0.7"/>
        <GradientStop Color="#006090" Offset="1"/>
    </LinearGradientBrush>

    <!-- Aurora Purple-Pink Gradient -->
    <LinearGradientBrush x:Key="AuroraPurplePinkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#a855f7" Offset="0"/>
        <GradientStop Color="#8b5cf6" Offset="0.3"/>
        <GradientStop Color="#ec4899" Offset="0.7"/>
        <GradientStop Color="#f472b6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Aurora Cyan-Green Gradient -->
    <LinearGradientBrush x:Key="AuroraCyanGreenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22d3ee" Offset="0"/>
        <GradientStop Color="#06b6d4" Offset="0.3"/>
        <GradientStop Color="#10b981" Offset="0.7"/>
        <GradientStop Color="#34d399" Offset="1"/>
    </LinearGradientBrush>

    <!-- Accent Gradient Horizontal -->
    <LinearGradientBrush x:Key="AccentGradientHorizontalBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#60e0ff" Offset="0"/>
        <GradientStop Color="#00c8ff" Offset="0.5"/>
        <GradientStop Color="#0090cc" Offset="1"/>
    </LinearGradientBrush>

    <!-- Steel Metallic Gradient -->
    <LinearGradientBrush x:Key="SteelGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#64748b" Offset="0"/>
        <GradientStop Color="#536179" Offset="0.45"/>
        <GradientStop Color="#475569" Offset="0.55"/>
        <GradientStop Color="#3b4a5c" Offset="1"/>
    </LinearGradientBrush>

    <!-- Steel Metallic Card Background -->
    <LinearGradientBrush x:Key="SteelCardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#152545" Offset="0"/>
        <GradientStop Color="#101e38" Offset="0.5"/>
        <GradientStop Color="#0d1830" Offset="1"/>
    </LinearGradientBrush>

    <!-- Success Gradient (Emerald) -->
    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34d399" Offset="0"/>
        <GradientStop Color="#10b981" Offset="0.4"/>
        <GradientStop Color="#059669" Offset="0.7"/>
        <GradientStop Color="#047857" Offset="1"/>
    </LinearGradientBrush>

    <!-- Danger Gradient (Rose) -->
    <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#f87171" Offset="0"/>
        <GradientStop Color="#ef4444" Offset="0.4"/>
        <GradientStop Color="#dc2626" Offset="0.7"/>
        <GradientStop Color="#b91c1c" Offset="1"/>
    </LinearGradientBrush>

    <!-- Warning Gradient (Amber/Orange) -->
    <LinearGradientBrush x:Key="WarningGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#fbbf24" Offset="0"/>
        <GradientStop Color="#f59e0b" Offset="0.4"/>
        <GradientStop Color="#d97706" Offset="0.7"/>
        <GradientStop Color="#b45309" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card Background Gradient (Deep Ocean Aurora) -->
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#122448" Offset="0"/>
        <GradientStop Color="#0e1c3a" Offset="0.3"/>
        <GradientStop Color="#0a1530" Offset="0.7"/>
        <GradientStop Color="#081228" Offset="1"/>
    </LinearGradientBrush>

    <!-- Sidebar Gradient (Deep Aurora) -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0a1428" Offset="0"/>
        <GradientStop Color="#070f20" Offset="0.5"/>
        <GradientStop Color="#050a18" Offset="1"/>
    </LinearGradientBrush>

    <!-- Header Bar Gradient -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#152545" Offset="0"/>
        <GradientStop Color="#101e38" Offset="0.5"/>
        <GradientStop Color="#0d1830" Offset="1"/>
    </LinearGradientBrush>

    <!-- Lava Lamp Gradient 1 (Purple-Cyan) -->
    <RadialGradientBrush x:Key="LavaLamp1Brush" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#308b5cf6" Offset="0"/>
        <GradientStop Color="#1506b6d4" Offset="0.5"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- Lava Lamp Gradient 2 (Pink-Orange) -->
    <RadialGradientBrush x:Key="LavaLamp2Brush" GradientOrigin="0.7,0.7" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#25ec4899" Offset="0"/>
        <GradientStop Color="#10f59e0b" Offset="0.5"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- Lava Lamp Gradient 3 (Cyan-Green) -->
    <RadialGradientBrush x:Key="LavaLamp3Brush" GradientOrigin="0.5,0.2" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#2006b6d4" Offset="0"/>
        <GradientStop Color="#1010b981" Offset="0.5"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- Glow Effect Brush (Ocean Cyan) -->
    <RadialGradientBrush x:Key="AccentGlowBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#5000c8ff" Offset="0"/>
        <GradientStop Color="#2000c8ff" Offset="0.5"/>
        <GradientStop Color="#0000c8ff" Offset="1"/>
    </RadialGradientBrush>

    <!-- Inner Highlight (For 3D emboss effect) -->
    <LinearGradientBrush x:Key="InnerHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#25ffffff" Offset="0"/>
        <GradientStop Color="#00ffffff" Offset="0.5"/>
    </LinearGradientBrush>

    <!-- Inner Shadow (For 3D inset effect) -->
    <LinearGradientBrush x:Key="InnerShadowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.5"/>
        <GradientStop Color="#35000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================== -->
    <!-- Drop Shadow Effects                           -->
    <!-- ============================================== -->

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="30"
                      ShadowDepth="5"
                      Direction="270"
                      Color="#000508"
                      Opacity="0.7"/>

    <DropShadowEffect x:Key="CardShadowHover"
                      BlurRadius="40"
                      ShadowDepth="8"
                      Direction="270"
                      Color="#000508"
                      Opacity="0.8"/>

    <DropShadowEffect x:Key="AccentGlow"
                      BlurRadius="25"
                      ShadowDepth="0"
                      Color="{StaticResource AccentPrimaryColor}"
                      Opacity="0.6"/>

    <DropShadowEffect x:Key="SuccessGlow"
                      BlurRadius="25"
                      ShadowDepth="0"
                      Color="{StaticResource SuccessColor}"
                      Opacity="0.6"/>

    <DropShadowEffect x:Key="DangerGlow"
                      BlurRadius="25"
                      ShadowDepth="0"
                      Color="{StaticResource DangerColor}"
                      Opacity="0.6"/>

    <DropShadowEffect x:Key="WarningGlow"
                      BlurRadius="25"
                      ShadowDepth="0"
                      Color="{StaticResource WarningColor}"
                      Opacity="0.6"/>

    <DropShadowEffect x:Key="AuroraPurpleGlow"
                      BlurRadius="25"
                      ShadowDepth="0"
                      Color="{StaticResource AuroraPurpleColor}"
                      Opacity="0.5"/>

    <DropShadowEffect x:Key="AuroraPinkGlow"
                      BlurRadius="25"
                      ShadowDepth="0"
                      Color="{StaticResource AuroraPinkColor}"
                      Opacity="0.5"/>

    <DropShadowEffect x:Key="ButtonShadow"
                      BlurRadius="10"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.5"/>

    <DropShadowEffect x:Key="ButtonShadowPressed"
                      BlurRadius="5"
                      ShadowDepth="1"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.4"/>

</ResourceDictionary>
